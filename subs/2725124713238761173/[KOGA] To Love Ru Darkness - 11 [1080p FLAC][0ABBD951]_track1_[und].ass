Comment: 0,0:10:02.80,0:10:03.72,Default,,0000,0000,0000,,Không có gì đâu ạ
Comment: 0,0:14:54.84,0:14:55.38,Default,,0000,0000,0000,,Oh!
Dialogue: 0,0:00:05.87,0:00:07.25,Default,,0000,0000,0000,,Cám ơn em, Momo.
Dialogue: 0,0:00:07.26,0:00:08.22,Default,,0000,0000,0000,,Em đã cứu anh đó!
Dialogue: 0,0:00:08.36,0:00:09.42,Default,,0000,0000,0000,,Có gì đâu
Dialogue: 0,0:00:09.46,0:00:11.36,Default,,0000,0000,0000,,Chỉ là em đang tình cờ thấy hết mọi chuyện thôi mà.
Dialogue: 0,0:00:11.75,0:00:15.80,Default,,0000,0000,0000,,Thiệt tình. Phát minh của Onee-sama lúc nào cũng gây rắc rối.
Dialogue: 0,0:00:15.80,0:00:17.90,Default,,0000,0000,0000,,Nhưng mặc dù như vậy...
Dialogue: 0,0:00:24.10,0:00:25.70,Default,,0000,0000,0000,,L-Lâu rồi không gặp.
Dialogue: 0,0:00:25.70,0:00:28.26,Default,,0000,0000,0000,,Thật mừng khi thấy con vẫn khỏe, Eve.
Dialogue: 0,0:00:29.74,0:00:33.50,Default,,0000,0000,0025,,Bây giờ hãy gọi tôi là Konjiki no Yami, hoặc là Yami-chan.
Dialogue: 0,0:00:34.42,0:00:36.66,Default,,0000,0000,0025,,Con người tôi ngày trước đã không còn nữa.
Dialogue: 0,0:00:36.84,0:00:38.76,Default,,0000,0000,0000,,P-Phải rồi nhỉ.
Dialogue: 0,0:00:44.23,0:00:48.32,Default,,0000,0000,0000,,Q-Quả nhiên là con vẫn còn giận, đúng không?
Dialogue: 0,0:00:48.56,0:00:50.46,Default,,0000,0000,0000,,Vì cô đã bỏ con ở lại.
Dialogue: 0,0:00:55.29,0:00:59.16,Default,,0000,0000,0000,,Ngày hôm ấy, tổ chức đã định trừ khử cô.
Dialogue: 0,0:00:59.82,0:01:01.92,Default,,0000,0000,0000,,{\a6}Cô đã định cùng con chạy trốn.
Dialogue: 0,0:01:10.19,0:01:13.70,Default,,0000,0000,0000,,Nhưng họ đã nhanh hơn một bước.
Dialogue: 0,0:01:15.89,0:01:16.54,Default,,0000,0000,0000,,Eve!
Dialogue: 0,0:01:24.30,0:01:29.10,Default,,0000,0000,0000,,Việc duy nhất cô có thể làm là tự cứu mình.
Dialogue: 0,0:01:30.95,0:01:33.72,Default,,0000,0000,0000,,Trong khi đang lang thang từ hành tinh này tới hành tinh khác,
Dialogue: 0,0:01:33.95,0:01:38.74,Default,,0000,0000,0000,,cô biết được rằng tổ chức đã bị hủy diệt \Nvà bắt đầu tìm kiếm con.
Dialogue: 0,0:01:40.26,0:01:41.52,Default,,0000,0000,0000,,Nhưng cô đã không thể tìm được.
Dialogue: 0,0:01:46.10,0:01:51.30,Default,,0000,0000,0000,,Lời đồn về Konjiki no Yami, người mà cả thế giới ngầm run sợ, đến được tai cô.
Dialogue: 0,0:01:52.20,0:01:54.44,Default,,0000,0000,0000,,cô biết ngay đó là con,
Dialogue: 0,0:01:55.77,0:01:57.34,Default,,0000,0000,0000,,nhưng cô lại không muốn tin.
Dialogue: 0,0:01:59.23,0:02:01.56,Default,,0000,0000,0000,,con đã từng rất vui vẻ và tốt bụng.
Dialogue: 0,0:02:01.56,0:02:05.22,Default,,0000,0000,0000,,cô không biết con đã tuyệt vọng đến mức nào khi lại sống theo cách đó.
Dialogue: 0,0:02:12.69,0:02:13.62,Default,,0000,0000,0000,,Xin lỗi con nhé.
Dialogue: 0,0:02:16.13,0:02:17.66,Default,,0000,0000,0000,,Cô xin lỗi.
Dialogue: 0,0:02:35.86,0:02:37.74,Default,,0000,0000,0000,,Sao cũng được.
Dialogue: 0,0:02:40.01,0:02:44.23,Default,,0000,0000,0000,,Dù cô có xin lỗi, tôi cũng không thể bắt đầu lại,
Dialogue: 0,0:02:45.15,0:02:49.69,Default,,0000,0000,0000,,và bỏ đi cái danh hiệu Konjiki no Yami.
Dialogue: 0,0:02:51.56,0:02:55.00,Default,,0000,0000,0000,,Trong tâm trí tôi lúc này chỉ có duy nhất một điều:
Dialogue: 0,0:02:59.81,0:03:01.78,Default,,0000,0000,0000,,Tôi mừng vì thấy cô còn sống.
Dialogue: 0,0:03:02.86,0:03:04.94,Default,,0000,0000,0000,,Chỉ cần như vậy thôi, Tear.
Dialogue: 0,0:03:18.25,0:03:19.26,Default,,0000,0000,0000,,Cô ấy đi rồi.
Dialogue: 0,0:03:20.06,0:03:22.14,Default,,0000,0000,0000,,Yami-san thật là không thật lòng gì cả.
Dialogue: 0,0:03:22.35,0:03:24.36,Default,,0000,0000,0000,,Hai người họ nên ôm nhau mới đúng chứ.
Dialogue: 0,0:03:24.54,0:03:26.14,Default,,0000,0000,0000,,Biết làm sao được.
Dialogue: 0,0:03:26.74,0:03:30.27,Default,,0000,0000,0000,,Cả hai người đều cảm thấy tội lỗi khi nhìn người còn lại.
Dialogue: 0,0:03:31.80,0:03:36.73,Default,,0000,0000,0000,,Hàn gắn một mối quan hệ đã tan vỡ không dễ chút nào.
Dialogue: 0,0:03:40.90,0:03:42.76,Default,,0000,0000,0000,,{\i1}Nhưng một ngày nào đó,
Dialogue: 0,0:03:42.76,0:03:44.98,Default,,0000,0000,0000,,{\i1}dù mất một khoảng thời gian cũng được,
Dialogue: 0,0:03:47.42,0:03:49.14,Default,,0000,0000,0000,,{\i1}hai người rồi sẽ trở lại như xưa.
Dialogue: 0,0:05:32.09,0:05:32.76,Default,,0000,0000,0000,,Mea!
Dialogue: 0,0:05:33.19,0:05:37.28,Default,,0000,0000,0000,,Mình nghe rằng bên lớp chị mình có một cô giáo mới trông giống hệt Yami!
Dialogue: 0,0:05:37.51,0:05:39.04,Default,,0000,0000,0000,,Lát đi xem thử không?
Dialogue: 0,0:05:39.23,0:05:40.83,Default,,0000,0000,0000,,Ừ, phải ha.
Dialogue: 0,0:05:41.23,0:05:43.70,Default,,0000,0000,0000,,Mình nghe nói ngực cô ấy rất bự đấy.
Dialogue: 0,0:05:43.83,0:05:45.04,Default,,0000,0000,0000,,Cậu cũng tò mò đúng không?!
Dialogue: 0,0:05:48.12,0:05:50.54,Default,,0000,0000,0000,,{\i1}Tearju Lunatique.
Dialogue: 0,0:05:52.19,0:05:56.68,Default,,0000,0000,0000,,Konjiki no Yami đã không chấp nhận mình là một vũ khí
Dialogue: 0,0:05:56.89,0:06:01.04,Default,,0000,0000,0000,,và muốn thử sống như một con người bình thường.
Dialogue: 0,0:06:05.50,0:06:06.59,Default,,0000,0000,0000,,Ghê thật!
Dialogue: 0,0:06:06.85,0:06:08.78,Default,,0000,0000,0000,,Phải làm sao để ngực mình bự được như thế nhỉ!
Dialogue: 0,0:06:13.35,0:06:14.49,Default,,0000,0000,0000,,Đi thôi, Nana-chan.
Dialogue: 0,0:06:14.49,0:06:16.49,Default,,0000,0000,0000,,Ế? S-Sao thế, Mea?
Dialogue: 0,0:06:16.64,0:06:18.83,Default,,0000,0000,0000,,Mình định nói chuyện với cô ấy một lát cơ mà!
Dialogue: 0,0:06:19.99,0:06:21.21,Default,,0000,0000,0000,,{\i1}Cô gái đó là...
Dialogue: 0,0:06:21.47,0:06:22.92,Default,,0000,0000,0000,,Nè, Mea!
Dialogue: 0,0:06:51.87,0:06:53.45,Default,,0000,0000,0000,,Cậu ấy đi đâu rồi?
Dialogue: 0,0:07:07.14,0:07:08.28,Default,,0000,0000,0000,,Yami!
Dialogue: 0,0:07:09.07,0:07:10.46,Default,,0000,0000,0000,,Cậu có thấy Mea không?
Dialogue: 0,0:07:10.68,0:07:11.22,Default,,0000,0000,0000,,Không.
Dialogue: 0,0:07:11.34,0:07:12.42,Default,,0000,0000,0000,,Vậy sao...
Dialogue: 0,0:07:13.42,0:07:15.78,Default,,0000,0000,0000,,Có chuyện gì xảy ra với Kurosaki Mea sao?
Dialogue: 0,0:07:15.99,0:07:16.92,Default,,0000,0000,0000,,À không.
Dialogue: 0,0:07:17.11,0:07:19.47,Default,,0000,0000,0000,,Không có chuyện gì xảy ra đâu, nhưng mà...
Dialogue: 0,0:07:23.68,0:07:26.90,Default,,0000,0000,0000,,Nana, Mea là bạn cậu à?
Dialogue: 0,0:07:29.09,0:07:30.68,Default,,0000,0000,0000,,Ở bên cạnh bạn bè,
Dialogue: 0,0:07:31.63,0:07:33.08,Default,,0000,0000,0000,,hơn nữa, ở với Mikan,
Dialogue: 0,0:07:33.92,0:07:35.41,Default,,0000,0000,0000,,làm tôi cảm thấy như được sống.
Dialogue: 0,0:07:57.06,0:07:58.12,Default,,0000,0000,0000,,Em là...
Dialogue: 0,0:07:58.23,0:08:01.10,Default,,0000,0000,0000,,À, cô có thấy cô gái nào tên Kurosaki Mea đi quanh đây không ạ?
Dialogue: 0,0:08:01.25,0:08:02.44,Default,,0000,0000,0000,,Kurosaki?
Dialogue: 0,0:08:02.62,0:08:03.82,Default,,0000,0000,0000,,Cậu ấy có tóc màu đỏ.
Dialogue: 0,0:08:04.01,0:08:05.44,Default,,0000,0000,0000,,Không, cô khộng thấy.
Dialogue: 0,0:08:05.44,0:08:06.62,Default,,0000,0000,0000,,Vậy à.
Dialogue: 0,0:08:14.73,0:08:15.70,Default,,0000,0000,0000,,Mea!
Dialogue: 0,0:08:17.32,0:08:18.78,Default,,0000,0000,0000,,Cậu đã đi đâu vậy?
Dialogue: 0,0:08:19.69,0:08:20.83,Default,,0000,0000,0000,,Mình đi vệ sinh.
Dialogue: 0,0:08:21.33,0:08:22.10,Default,,0000,0000,0000,,Vậy à.
Dialogue: 0,0:08:22.61,0:08:24.33,Default,,0000,0000,0000,,Có chuyện gì sao?
Dialogue: 0,0:08:24.33,0:08:25.36,Default,,0000,0000,0000,,Không.
Dialogue: 0,0:08:26.41,0:08:29.02,Default,,0000,0000,0000,,Chuyện gì thế, Nana-chan? Cậu lạ ghê.
Dialogue: 0,0:08:32.01,0:08:33.32,Default,,0000,0000,0000,,Ra vậy.
Dialogue: 0,0:08:33.32,0:08:34.92,Default,,0000,0000,0000,,Việc đó {\i1}thật sự{\i0} hơi đáng lo đấy.
Dialogue: 0,0:08:35.12,0:08:39.49,Default,,0000,0000,0000,,Ừm, cậu ấy hành động rất khác với lần trước, khi cậu ấy xuống tinh thần.
Dialogue: 0,0:08:39.61,0:08:42.52,Default,,0000,0000,0000,,Có khi nào em ấy đang lo lắng về thứ gì đó và giữ trong lòng không nhỉ?
Dialogue: 0,0:08:43.43,0:08:47.48,Default,,0000,0000,0000,,Em có nên đợi cho đến khi Mea tự nói ra thì hơn không?
Dialogue: 0,0:08:48.09,0:08:50.74,Default,,0000,0000,0000,,Có khi là thứ gì đó em ấy không muốn nói ở trường.
Dialogue: 0,0:08:55.43,0:08:56.79,Default,,0000,0000,0000,,Xin lỗi em.
Dialogue: 0,0:08:56.79,0:08:58.26,Default,,0000,0000,0000,,À, không có gì đâu ạ.
Dialogue: 0,0:08:59.91,0:09:02.90,Default,,0000,0000,0000,,Em là em gái của Lala-san, phải không?
Dialogue: 0,0:09:03.03,0:09:05.51,Default,,0000,0000,0000,,Đúng vậy. Sao cô biết hay vậy?
Dialogue: 0,0:09:05.67,0:09:08.10,Default,,0000,0000,0000,,Bạn gái mà em tìm kiếm lúc nãy...
Dialogue: 0,0:09:08.32,0:09:09.71,Default,,0000,0000,0000,,À, là Mea ạ?
Dialogue: 0,0:09:11.00,0:09:12.17,Default,,0000,0000,0000,,Em ấy là bạn em sao?
Dialogue: 0,0:09:12.42,0:09:14.43,Default,,0000,0000,0000,,À, đúng thế.
Dialogue: 0,0:09:14.43,0:09:15.63,Default,,0000,0000,0000,,Vậy à.
Dialogue: 0,0:09:17.92,0:09:21.09,Default,,0000,0000,0000,,Hãy giúp đỡ Mea-san nhé!
Dialogue: 0,0:09:30.02,0:09:31.02,Default,,0000,0000,0000,,Anh về rồi!
Dialogue: 0,0:09:36.32,0:09:37.28,Default,,0000,0000,0000,,Sairenji?
Dialogue: 0,0:09:37.42,0:09:38.66,Default,,0000,0000,0000,,Mình xin phép làm phiền.
Dialogue: 0,0:09:38.83,0:09:39.60,Default,,0000,0000,0000,,Có chuyện gì vậy?
Dialogue: 0,0:09:39.60,0:09:40.94,Default,,0000,0000,0000,,Một chút thôi!
Dialogue: 0,0:09:41.45,0:09:42.94,Default,,0000,0000,0000,,Em đang làm gì thế, Nana?
Dialogue: 0,0:09:42.94,0:09:44.16,Default,,0000,0000,0000,,Im đi.
Dialogue: 0,0:09:44.30,0:09:45.02,Default,,0000,0000,0000,,Có sao đâu.
Dialogue: 0,0:09:45.15,0:09:47.54,Default,,0000,0000,0000,,Nana, Cha đồng ý rồi đó!
Dialogue: 0,0:09:47.54,0:09:50.08,Default,,0000,0000,0000,,Thật chứ? Hay quá!
Dialogue: 0,0:09:53.23,0:09:54.58,Default,,0000,0000,0000,,Yahoo!
Dialogue: 0,0:09:54.74,0:09:55.59,Default,,0000,0000,0000,,Xin chào!
Dialogue: 0,0:10:00.81,0:10:02.60,Default,,0000,0000,0000,,Xin lỗi vì làm phiền em lúc này nhé!
Dialogue: 0,0:10:03.93,0:10:07.58,Default,,0000,0000,0000,,Dù em không hiểu lắm, nhưng nếu vui vẻ thì em sẵn sàng làm tất cả!
Dialogue: 0,0:10:08.50,0:10:09.92,Default,,0000,0000,0000,,Mong sao được như vậy nhỉ.
Dialogue: 0,0:10:11.43,0:10:13.42,Default,,0000,0000,0000,,Nana-chan là một cô gái tốt, phải không?
Dialogue: 0,0:10:13.62,0:10:14.80,Default,,0000,0000,0000,,Lúc nào cũng tràn đầy sức sống.
Dialogue: 0,0:10:16.27,0:10:16.84,Default,,0000,0000,0000,,Vâng!
Dialogue: 0,0:10:23.86,0:10:25.64,Default,,0000,0000,0000,,Đây thật sự là phòng{\i1} của mình{\i0} sao?
Dialogue: 0,0:10:25.84,0:10:27.02,Default,,0000,0000,0000,,Rất tuyệt đúng không?
Dialogue: 0,0:10:27.18,0:10:30.71,Default,,0000,0000,0000,,Haruna đã chọn đồ nội thất, còn chúng tớ thì lo trang trí.
Dialogue: 0,0:10:31.38,0:10:34.84,Default,,0000,0000,0000,,Quả nhiên ở trong một căn phòng rực rỡ thế này, thì tinh thần sẽ thoải mái hơn nhỉ.
Dialogue: 0,0:10:34.84,0:10:35.92,Default,,0000,0000,0000,,Đúng thế.
Dialogue: 0,0:10:36.74,0:10:40.59,Default,,0000,0000,0000,,Nhưng tất cả chỗ này không phải rất tốn kém sao?
Dialogue: 0,0:10:41.06,0:10:42.26,Default,,0000,0000,0000,,Không sao! Không sao!
Dialogue: 0,0:10:42.39,0:10:44.34,Default,,0000,0000,0000,,Tớ là một công chúa mà.
Dialogue: 0,0:10:44.34,0:10:46.38,Default,,0000,0000,0000,,Cô đang nói gì thế?
Dialogue: 0,0:10:46.38,0:10:50.82,Default,,0000,0000,0000,,Tôi nghe là cô đã ứng trước 6 tháng tiền trợ cấp từ Gid-sama.
Dialogue: 0,0:10:51.01,0:10:53.16,Default,,0000,0000,0000,,Ê này, Peke, đừng nói chuyện dư thừa!
Dialogue: 0,0:10:54.26,0:10:55.68,Default,,0000,0000,0000,,Nana-chan, còn cái đó đâu?
Dialogue: 0,0:10:55.84,0:10:56.69,Default,,0000,0000,0000,,À, phải rồi.
Dialogue: 0,0:10:58.22,0:11:00.86,Default,,0000,0000,0000,,Tuy tớ làm không được tốt cho lắm...
Dialogue: 0,0:11:03.05,0:11:05.74,Default,,0000,0000,0000,,Với cái này thì phòng mới của Mea đã hoàn thành!
Dialogue: 0,0:11:05.74,0:11:08.84,Default,,0000,0000,0000,,Trông nó hơi xấu vì Nana có rành vụ này đâu,
Dialogue: 0,0:11:08.84,0:11:10.66,Default,,0000,0000,0000,,nhưng em ấy dành tất cả tình cảm của mình vào nó đó!
Dialogue: 0,0:11:10.66,0:11:11.90,Default,,0000,0000,0000,,C-Chị à!
Dialogue: 0,0:11:11.90,0:11:13.33,Default,,0000,0000,0000,,Tự nhiên nói gì kì thế!
Dialogue: 0,0:11:15.08,0:11:16.00,Default,,0000,0000,0000,,Nana-chan!
Dialogue: 0,0:11:17.37,0:11:18.38,Default,,0000,0000,0000,,Cám ơn cậu!
Dialogue: 0,0:11:22.11,0:11:23.13,Default,,0000,0000,0000,,Tốt quá rồi!
Dialogue: 0,0:11:24.07,0:11:26.30,Default,,0000,0000,0000,,Gần đây cậu trông lạ lắm.
Dialogue: 0,0:11:26.30,0:11:28.47,Default,,0000,0000,0000,,Cứ như có ai đó làm phiền cậu vậy!
Dialogue: 0,0:11:29.55,0:11:30.28,Default,,0000,0000,0000,,Thật sao?
Dialogue: 0,0:11:31.82,0:11:33.85,Default,,0000,0000,0000,,Nhưng giờ trông cậu có vẻ vui lên rồi.
Dialogue: 0,0:11:51.31,0:11:52.04,Default,,0000,0000,0000,,Mea...
Dialogue: 0,0:11:52.89,0:11:53.72,Default,,0000,0000,0000,,Um...
Dialogue: 0,0:12:07.02,0:12:13.02,Default,,0000,0000,0000,,Vậy là cả cô cũng không biết gì về Mea-san và chủ nhân của cô ấy sao, Tearju-sensei?
Dialogue: 0,0:12:13.22,0:12:13.87,Default,,0000,0000,0000,,Ừm
Dialogue: 0,0:12:14.05,0:12:19.72,Default,,0000,0000,0000,,Cô không biết chi tiết tất cả kế hoạch khi còn ở tổ chức.
Dialogue: 0,0:12:20.40,0:12:22.98,Default,,0000,0000,0000,,Nhưng cô nghĩ rằng Kurosaki Mea...
Dialogue: 0,0:12:23.26,0:12:28.71,Default,,0000,0000,0000,,là vũ khí đời 2 dựa trên nghiên cứu của Yami-chan.
Dialogue: 0,0:12:29.52,0:12:31.40,Default,,0000,0000,0000,,Tạo ra vũ khí hàng loạt.
Dialogue: 0,0:12:32.17,0:12:35.71,Default,,0000,0000,0000,,Đó là mục tiêu quan trọng nhất của tổ chức mà.
Dialogue: 0,0:12:36.40,0:12:40.98,Default,,0000,0000,0000,,Master của cô ấy, bây giờ cô chỉ có thể đoán rằng...
Dialogue: 0,0:12:41.77,0:12:44.00,Default,,0000,0000,0000,,đó là một trong những người nghiên cứu còn sống,
Dialogue: 0,0:12:44.00,0:12:45.47,Default,,0000,0000,0000,,hoặc là...
Dialogue: 0,0:12:46.53,0:12:49.62,Default,,0000,0000,0000,,Xin lỗi nha, cô chỉ biết nhiêu đó thôi!
Dialogue: 0,0:12:49.62,0:12:54.22,Default,,0000,0000,0000,,Không ạ, có cô ở đây thì em thật sự yên tâm rồi.
Dialogue: 0,0:12:54.22,0:12:55.81,Default,,0000,0000,0000,,Vậy nên cô cầm cái này đi.
Dialogue: 0,0:12:56.47,0:12:57.34,Default,,0000,0000,0000,,Đây là...
Dialogue: 0,0:12:57.52,0:12:59.18,Default,,0000,0000,0000,,Hạt giống một loại cây.
Dialogue: 0,0:12:59.39,0:13:02.24,Default,,0000,0000,0000,,Khi cô ném nó xuống đất, nó sẽ mọc lên rất nhanh,
Dialogue: 0,0:13:02.41,0:13:05.40,Default,,0000,0000,0000,,trói chặt cơ thể đối phương, không cho họ cử động.
Dialogue: 0,0:13:06.10,0:13:10.38,Default,,0000,0000,0000,,Nó đã được cải tiến, mỗi khi nó nảy mầm nó sẽ phát ra tín hiệu,
Dialogue: 0,0:13:11.23,0:13:13.41,Default,,0000,0000,0000,,và em sẽ đến ngay nếu có chuyện gì xảy ra.
Dialogue: 0,0:13:15.19,0:13:19.48,Default,,0000,0000,0000,,Chủ nhân Mea có thể sẽ giở trò gì đó với cô đó
Dialogue: 0,0:13:19.70,0:13:21.72,Default,,0000,0000,0000,,thế nên hãy mang cái này theo để phòng thân.
Dialogue: 0,0:13:21.94,0:13:23.22,Default,,0000,0000,0000,,Cám ơn em!
Dialogue: 0,0:13:23.42,0:13:24.76,Default,,0000,0000,0000,,Cô rất vui, Momo-chan.
Dialogue: 0,0:13:26.03,0:13:29.08,Default,,0000,0000,0000,,Em ấy đã làm bạn được với người đáng tin cậy như em.
Dialogue: 0,0:13:30.67,0:13:32.92,Default,,0000,0000,0000,,Yami-san là người bảo em làm chuyện này.
Dialogue: 0,0:13:33.09,0:13:34.47,Default,,0000,0000,0000,,Em ấy nói vậy sao?
Dialogue: 0,0:13:37.10,0:13:39.14,Default,,0000,0000,0000,,{\i1}Nhờ cậu lo cho Tear.
Dialogue: 0,0:13:42.81,0:13:45.73,Default,,0000,0000,0000,,Cậu ấy thực sự không thành thật với bản thân mà.
Dialogue: 0,0:13:46.69,0:13:47.46,Default,,0000,0000,0000,,Vậy à.
Dialogue: 0,0:13:49.21,0:13:53.12,Default,,0000,0000,0000,,Vậy là bản sao cũng khác hẳn nhau nhỉ?
Dialogue: 0,0:13:53.12,0:13:54.92,Default,,0000,0000,0000,,Giống như Tearju-sensei và Yami-san.
Dialogue: 0,0:13:54.92,0:13:56.10,Default,,0000,0000,0000,,Vậy sao...
Dialogue: 0,0:13:56.32,0:13:57.83,Default,,0000,0000,0000,,Và cơ thể của họ...
Dialogue: 0,0:13:58.53,0:14:03.36,Default,,0000,0000,0000,,Mặc dù vào lúc đó Tearju-sensei bằng tuổi em và Yami-san,
Dialogue: 0,0:14:03.39,0:14:05.86,Default,,0000,0000,0000,,Nhưng có lẽ điều kiện môi trường có ảnh hưởng,
Dialogue: 0,0:14:05.86,0:14:07.48,Default,,0000,0000,0000,,dù họ đều mang gen giống nhau.
Dialogue: 0,0:14:07.66,0:14:11.08,Default,,0000,0000,0000,,Anh nghĩ em không nên nói điều đó với Yami thì hơn.
Dialogue: 0,0:14:11.26,0:14:12.80,Default,,0000,0000,0000,,Thôi đủ rồi.
Dialogue: 0,0:14:13.25,0:14:17.12,Default,,0000,0000,0000,,Anh không nghĩ là thêm cả Tearju-sensei và Yami-san vào harem của anh
Dialogue: 0,0:14:17.14,0:14:19.40,Default,,0000,0000,0000,,thì mọi chuyện sẽ "thú vị" hơn sao?
Dialogue: 0,0:14:20.28,0:14:21.40,Default,,0000,0000,0000,,{\i1}Yuuki-kun...
Dialogue: 0,0:14:21.40,0:14:24.08,Default,,0000,0000,0000,,{\i1}em có muốn cô lau người cho em không?
Dialogue: 0,0:14:24.08,0:14:26.15,Default,,0000,0000,0000,,{\i1}Nếu Tear làm thì tôi cũng sẽ làm.
Dialogue: 0,0:14:26.15,0:14:28.88,Default,,0000,0000,0000,,{\i1}Phải giữ bí mật với mấy bạn trong lớp đó!
Dialogue: 0,0:14:31.86,0:14:33.76,Default,,0000,0000,0000,,C-Cái...
Dialogue: 0,0:14:33.76,0:14:36.70,Default,,0000,0000,0000,,Em đang nói gì thế?!
Dialogue: 0,0:14:34.45,0:14:36.70,Alternative,,0000,0000,0000,,Chỉ đùa thôi mà, hên xui!
Dialogue: 0,0:14:42.71,0:14:44.12,Default,,0000,0000,0000,,Tearju-sensei!
Dialogue: 0,0:14:44.87,0:14:45.96,Default,,0000,0000,0000,,Kokegawa-san!
Dialogue: 0,0:14:46.10,0:14:47.46,Default,,0000,0000,0000,,Em vẫn còn ở trường à?
Dialogue: 0,0:14:47.46,0:14:50.08,Default,,0000,0000,0000,,Vâng. Em có cuộc họp với ban kỷ luật.
Dialogue: 0,0:14:51.49,0:14:53.17,Default,,0000,0000,0000,,Và...
Dialogue: 0,0:14:53.17,0:14:54.84,Default,,0000,0000,0000,,Em tên là {\i1}Kotegawa{\i0} ạ.
Dialogue: 0,0:14:55.38,0:14:57.14,Default,,0000,0000,0000,,X-Xin lỗi em!
Dialogue: 0,0:14:57.97,0:15:02.75,Default,,0000,0000,0000,,Sensei, nếu bọn con trai có làm việc "đáng xấu hổ" với cô, thì hãy báo ngay với em nhé.
Dialogue: 0,0:15:02.95,0:15:04.08,Default,,0000,0000,0000,,Đặc biệt là Yuuki-kun!
Dialogue: 0,0:15:04.26,0:15:05.98,Default,,0000,0000,0000,,Cậu ấy {\i1}cực kỳ{\i0} nguy hiểm!
Dialogue: 0,0:15:07.01,0:15:07.68,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:15:12.57,0:15:15.30,Default,,0000,0000,0000,,Đáng xấu hổ? Không biết là việc gì nhỉ.
Dialogue: 0,0:15:17.30,0:15:20.45,Default,,0000,0000,0000,,Hơn nữa, làm giáo viên khó hơn mình nghĩ.
Dialogue: 0,0:15:21.35,0:15:24.44,Default,,0000,0000,0000,,Chỉ nhớ tên học sinh cũng là cả một vấn về rồi.
Dialogue: 0,0:15:30.11,0:15:31.20,Default,,0000,0000,0000,,Cuối cùng...
Dialogue: 0,0:15:32.93,0:15:35.02,Default,,0000,0000,0000,,chúng ta cũng có thể nói chuyện thong thả nhỉ.
Dialogue: 0,0:15:37.17,0:15:39.76,Default,,0000,0000,0000,,Nói chuyện chút được không, Tiến sĩ?
Dialogue: 0,0:15:52.13,0:15:52.94,Default,,0000,0000,0000,,Tất nhiên.
Dialogue: 0,0:15:52.94,0:15:57.67,Default,,0000,0000,0000,,Cô cũng đã định nói chuyện với em, Mea-san.
Dialogue: 0,0:15:57.67,0:16:00.08,Default,,0000,0000,0000,,Vậy sao? Bất ngờ thật đấy.
Dialogue: 0,0:16:02.45,0:16:04.75,Default,,0000,0000,0000,,Thế cô muốn nói chuyện gì với em nào?
Dialogue: 0,0:16:13.71,0:16:14.76,Default,,0000,0000,0000,,Đây là...
Dialogue: 0,0:16:14.76,0:16:17.72,Default,,0000,0000,0000,,Đừng lại gần Tearju-sensei thêm chút nào nữa!
Dialogue: 0,0:16:17.72,0:16:19.85,Default,,0000,0000,0000,,Nếu cô muốn nói gì thì đứng đó nói luôn đi!
Dialogue: 0,0:16:20.35,0:16:22.78,Default,,0000,0000,0000,,Tôi đang trói chặt quần áo cũng như sức mạnh của cô.
Dialogue: 0,0:16:22.78,0:16:24.00,Default,,0000,0000,0000,,Nếu cô cố tình chống cự,
Dialogue: 0,0:16:24.00,0:16:26.52,Default,,0000,0000,0000,,quần áo cô sẽ rách và cô sẽ bị xấu hổ!
Dialogue: 0,0:16:27.83,0:16:31.10,Default,,0000,0000,0000,,{\i1}Mình là người duy nhất có thể kết nối trực tiếp với ý thức của Mea-san.
Dialogue: 0,0:16:31.10,0:16:34.14,Default,,0000,0000,0000,,{\i1}Cô ta nguy hiểm hơn nhiều so với mọi người nghĩ.
Dialogue: 0,0:16:34.32,0:16:37.95,Default,,0000,0000,0000,,{\i1}Là trợ lý của Mikado-sensei, mình có nhiệm vụ phải bảo vệ Tearju-sensei!
Dialogue: 0,0:16:43.70,0:16:45.37,Default,,0000,0000,0000,,Chúng rách thật rồi!
Dialogue: 0,0:16:46.57,0:16:49.11,Default,,0000,0000,0000,,Nhưng mà chị phải biết điều này, Murasame-senpai,
Dialogue: 0,0:16:49.11,0:16:52.05,Default,,0000,0000,0000,,như thế liệu đã đủ để bắt em nghe lời chị chưa?
Dialogue: 0,0:16:59.35,0:17:02.86,Default,,0000,0000,0000,,N-Nếu thế thì tôi sẽ trói luôn cơ thể cô mà không do dự!
Dialogue: 0,0:17:03.98,0:17:06.93,Default,,0000,0000,0000,,Lâu lắm rồi mình mới đối mặt với kẻ thù!
Dialogue: 0,0:17:07.36,0:17:08.52,Default,,0000,0000,0000,,Tuyệt vời!
Dialogue: 0,0:17:08.65,0:17:09.94,Default,,0000,0000,0000,,Dừng lại, cả hai em!
Dialogue: 0,0:17:10.96,0:17:11.59,Default,,0000,0000,0000,,Sensei?
Dialogue: 0,0:17:15.85,0:17:16.94,Default,,0000,0000,0000,,Gì thế, Momo?
Dialogue: 0,0:17:20.10,0:17:21.17,Default,,0000,0000,0000,,Tearju-sensei!
Dialogue: 0,0:17:24.77,0:17:25.94,Default,,0000,0000,0000,,Không...
Dialogue: 0,0:17:28.89,0:17:30.54,Default,,0000,0000,0000,,Đừng mà!
Dialogue: 0,0:17:30.79,0:17:32.62,Default,,0000,0000,0000,,Cái quái gì đã xảy ra ở đây vậy?!
Dialogue: 0,0:17:32.83,0:17:35.10,Default,,0000,0000,0000,,Hạt giống nảy mầm khi cô bị trượt chân nên...
Dialogue: 0,0:17:35.10,0:17:37.55,Default,,0000,0000,0000,,Cô ấy cũng hậu đậu giống Rito-san sao?!
Dialogue: 0,0:17:40.66,0:17:43.35,Default,,0000,0000,0000,,Đừng có mút mà!
Dialogue: 0,0:17:43.56,0:17:44.78,Default,,0000,0000,0000,,Celine!
Dialogue: 0,0:17:44.92,0:17:45.82,Default,,0000,0000,0000,,em sẽ tháo gỡ các nhánh cây ra ngay!
Dialogue: 0,0:17:47.09,0:17:49.35,Default,,0000,0000,0000,,Thật là một cảnh tượng thú vị!
Dialogue: 0,0:17:49.85,0:17:50.70,Default,,0000,0000,0000,,Mea!
Dialogue: 0,0:17:50.87,0:17:51.93,Default,,0000,0000,0000,,Sao em lại ở đây?
Dialogue: 0,0:17:52.38,0:17:54.16,Default,,0000,0000,0000,,Đừng hiểu nhầm, Senpai.
Dialogue: 0,0:17:54.39,0:17:58.11,Default,,0000,0000,0000,,Em chỉ muốn kiểm tra thử Tearju là con người thế nào thôi.
Dialogue: 0,0:17:58.96,0:18:02.66,Default,,0000,0000,0000,,Người gây sự trước là Murasame-senpai mà.
Dialogue: 0,0:18:03.83,0:18:06.62,Default,,0000,0000,0000,,"Đừng cho kẻ thù thấy bất kỳ sự thương xót nào."
Dialogue: 0,0:18:07.55,0:18:11.58,Default,,0000,0000,0000,,Đó là điều mà Chủ nhân Nemesis đã dạy cho em.
Dialogue: 0,0:18:12.11,0:18:13.88,Default,,0000,0000,0000,,Chủ nhân Nemesis?
Dialogue: 0,0:18:15.14,0:18:18.12,Default,,0000,0000,0000,,Cô đã từng nghe cái tên đó.
Dialogue: 0,0:18:19.77,0:18:22.01,Default,,0000,0000,0000,,Dự án Nemesis!
Dialogue: 0,0:18:22.17,0:18:27.36,Default,,0000,0000,0000,,Nó là một dự án hoạt động song song với dự án Eve, dự án đã sinh ra Yami-chan và em.
Dialogue: 0,0:18:27.49,0:18:29.48,Default,,0000,0000,0000,,Nó là một dự án hoàn toàn riêng biệt.
Dialogue: 0,0:18:29.90,0:18:34.56,Default,,0000,0000,0000,,Nhưng cô nghe rằng dự án đó đã thất bại và bị xếp xó.
Dialogue: 0,0:18:34.78,0:18:36.90,Default,,0000,0000,0000,,Không lẽ Chủ nhân của em là...
Dialogue: 0,0:18:37.27,0:18:38.54,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:18:38.54,0:18:43.66,Default,,0000,0000,0000,,Chủ nhân Nemesis là một vũ khí Trans được tạo ra trong dự án Nemesis.
Dialogue: 0,0:18:48.29,0:18:54.23,Default,,0000,0000,0000,,Điều đầu tiên tôi nhớ là cơ sở nghiên cứu bị phá hủy,
Dialogue: 0,0:18:54.23,0:18:56.26,Default,,0000,0000,0000,,và một vỏ bọc sinh học bị vỡ.
Dialogue: 0,0:18:57.41,0:19:06.70,Default,,0000,0000,0000,,Tôi đi qua đống đổ nát, không biết mình là ai và sao mình lại được sinh ra.
Dialogue: 0,0:19:08.37,0:19:11.56,Default,,0000,0000,0000,,Và khi đó tôi đã gặp ngài ấy.
Dialogue: 0,0:19:15.14,0:19:19.86,Default,,0000,0000,0000,,Chủ nhân đã dạy tôi cách sống như một vũ khí Trans.
Dialogue: 0,0:19:20.77,0:19:24.36,Default,,0000,0000,0000,,Làm sao để sử dụng sức mạnh, chuyện về Yami-oneechan...
Dialogue: 0,0:19:25.09,0:19:30.16,Default,,0000,0000,0000,,Tôi được như ngày hôm nay là nhờ Chủ nhân nuôi dạy.
Dialogue: 0,0:19:30.81,0:19:36.67,Default,,0000,0000,0000,,Chủ nhân là người duy nhất thật sự hiểu tôi và Yami-oneechan. Là người duy nhất có thể dẫn dắt chúng tôi,
Dialogue: 0,0:19:37.19,0:19:39.17,Default,,0000,0000,0000,,vì chúng tôi đều là vũ khí.
Dialogue: 0,0:19:40.31,0:19:44.86,Default,,0000,0000,0000,,Tearju, cô đã phá hoại mối quan hệ của chúng tôi.
Dialogue: 0,0:19:46.51,0:19:51.24,Default,,0000,0000,0000,,Đến bây giờ, cô có còn nghĩ là Yami-oneechan nên sống như một con người không?
Dialogue: 0,0:20:00.79,0:20:03.03,Default,,0000,0000,0000,,Có, cô vẫn nghĩ như vậy!
Dialogue: 0,0:20:06.30,0:20:09.66,Default,,0000,0000,0000,,Và cô mong em cũng sẽ sống như vậy.
Dialogue: 0,0:20:12.42,0:20:15.20,Default,,0000,0000,0000,,Nếu em là em gái của Yami-chan,
Dialogue: 0,0:20:15.71,0:20:17.96,Default,,0000,0000,0000,,thì cũng như là em gái của cô.
Dialogue: 0,0:20:19.15,0:20:20.48,Default,,0000,0000,0000,,Cô đang nói cái gì vậy?!
Dialogue: 0,0:20:20.72,0:20:21.56,Default,,0000,0000,0000,,Thật ngu ngốc.
Dialogue: 0,0:20:21.74,0:20:23.50,Default,,0000,0000,0000,,Không phải tôi là nói tôi là vũ khí sao!
Dialogue: 0,0:20:24.00,0:20:27.18,Default,,0000,0000,0000,,Chỉ cần Chủ nhân ra lệnh, tôi có thể loại bỏ cô ngay tức khắc!
Dialogue: 0,0:20:27.34,0:20:32.43,Default,,0000,0000,0000,,Em đang sống trong thị trấn này như một con người bình thường.
Dialogue: 0,0:20:33.29,0:20:35.24,Default,,0000,0000,0000,,Yami-chan cũng vậy, đúng không?
Dialogue: 0,0:20:37.81,0:20:40.90,Default,,0000,0000,0000,,Đ-Đó chỉ là vì Chủ nhân ra lệnh,
Dialogue: 0,0:20:41.29,0:20:42.84,Default,,0000,0000,0000,,hết cách rồi.
Dialogue: 0,0:20:46.29,0:20:49.86,Default,,0000,0000,0000,,Chúng tôi thật sự không thuộc về nơi này.
Dialogue: 0,0:20:55.39,0:20:56.02,Default,,0000,0000,0000,,Mea...
Dialogue: 0,0:20:57.40,0:21:00.18,Default,,0000,0000,0000,,Nếu em rời khỏi thị trấn này,
Dialogue: 0,0:21:00.18,0:21:02.67,Default,,0000,0000,0000,,anh nghĩ Nana sẽ rất buồn đó.
Dialogue: 0,0:21:04.35,0:21:05.92,Default,,0000,0000,0000,,Nana-chan?
Dialogue: 0,0:21:11.77,0:21:13.06,Default,,0000,0000,0000,,Cả Yami nữa.
Dialogue: 0,0:21:15.99,0:21:17.83,Default,,0000,0000,0000,,Cậu đã thay đổi.
Dialogue: 0,0:21:17.83,0:21:20.56,Default,,0000,0000,0000,,Cậu luôn nói bản thân là một vũ khí,
Dialogue: 0,0:21:20.77,0:21:22.48,Default,,0000,0000,0000,,nhưng cậu lại có một trái tim.
Dialogue: 0,0:21:23.31,0:21:28.28,Default,,0000,0000,0000,,Mình cũng muốn làm bạn với cậu.
Dialogue: 0,0:21:28.83,0:21:33.16,Default,,0000,0000,0000,,Cậu thấy đấy, vì mình là loại người rụt rè và không có nhiều bạn mà.
Dialogue: 0,0:21:42.87,0:21:43.62,Default,,0000,0000,0000,,Mea...
Dialogue: 0,0:21:46.09,0:21:48.08,Default,,0000,0000,0000,,Còn Senpai thì sao?
Dialogue: 0,0:21:52.99,0:21:58.72,Default,,0000,0000,0000,,Nếu anh liếm mọi phần cơ thể em,
Dialogue: 0,0:21:58.97,0:22:01.18,Default,,0000,0000,0000,,có khi em sẽ suy nghĩ lại một chút.
Dialogue: 0,0:22:02.51,0:22:04.20,Default,,0000,0000,0000,,Rito-san, làm đi!
Dialogue: 0,0:22:04.41,0:22:07.14,Default,,0000,0000,0000,,Yuuki-kun, nếu đó là những gì em ấy muốn thì hãy làm đi!
Dialogue: 0,0:22:07.24,0:22:08.35,Default,,0000,0000,0000,,Em không thể!
Dialogue: 0,0:22:08.37,0:22:11.04,Default,,0000,0000,0000,,Cơ mà Mea! Đừng tự nhiên đưa ra một yêu cầu như thế chứ!
Dialogue: 0,0:22:11.97,0:22:13.64,Default,,0000,0000,0000,,Quả nhiên là không được, phải không?
Dialogue: 0,0:22:13.91,0:22:18.58,Default,,0000,0000,0000,,Em biết rằng anh là loại người không thể làm được những chuyện như thế mà.
Dialogue: 0,0:22:24.32,0:22:28.09,Default,,0000,0000,0000,,Thế có nghĩa là không dễ để thay đổi trái tim người khác đâu.
Dialogue: 0,0:22:29.31,0:22:33.30,Default,,0000,0000,0000,,Thế nên Momo-chan mới mất rất nhiều thời gian với anh, đúng chứ?
Dialogue: 0,0:22:39.10,0:22:43.82,Default,,0000,0000,0000,,Mà dù gì thì em cũng sẽ tiếp tục làm theo những gì chủ nhân đã dạy.
Dialogue: 0,0:22:45.03,0:22:47.95,Default,,0000,0000,0000,,Nếu được thì hãy tiếp tục làm bạn với em nhé,
Dialogue: 0,0:22:48.28,0:22:49.96,Default,,0000,0000,0000,,Senpai, Momo-chan,
Dialogue: 0,0:22:49.96,0:22:52.84,Default,,0000,0000,0000,,và cô nữa, Tearju-sensei.
Dialogue: 0,0:23:02.69,0:23:07.20,Default,,0000,0000,0000,,{\i1}"Trái tim không dễ thay đổi," sao?
Dialogue: 0,0:23:09.77,0:23:11.77,Default,,0000,0000,0000,,{\i1}Nhưng mà, Mea-san,
Dialogue: 0,0:23:11.77,0:23:14.10,Default,,0000,0000,0000,,{\i1}dù cậu được sinh ra như một thứ vũ khí,
Dialogue: 0,0:23:14.36,0:23:16.80,Default,,0000,0000,0000,,{\i1}nhưng vẫn nhận biết được sự tồn tại của trái tim nhỉ.
Dialogue: 0,0:23:24.62,0:23:25.72,Default,,0000,0000,0000,,Anou...
Dialogue: 0,0:23:25.81,0:23:29.36,Default,,0000,0000,0000,,L-Làm ơn giúp mình nữa!
Dialogue: 0,0:23:29.36,0:23:30.06,Default,,0000,0000,0000,,Ờ.
