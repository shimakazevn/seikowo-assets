Dialogue: 0,0:00:01.38,0:00:05.02,1,,0,0,0,,Con yêu, hãy lắng nghe mẹ.
Dialogue: 0,0:00:05.32,0:00:09.96,1,,0,0,0,,Những gì mẹ sắp kể đây quan trọng vô cùng.
Dialogue: 0,0:00:10.16,0:00:22.50,1,,0,0,0,,Đây là câu chuyện về một chuyến hành trình dài, \Nrất dài được lưu truyền từ mẹ sang con.
Dialogue: 0,0:00:32.08,0:00:33.25,Yukito,,0,0,0,,Đói bụng quá.
Dialogue: 0,0:00:33.45,0:00:35.45,7,,0,0,0,,Trời ơi, đói quá!
Dialogue: 0,0:00:35.45,0:00:39.15,2,,0,0,0,,Nói hoài!
Dialogue: 0,0:00:37.05,0:00:39.15,3,,0,0,0,,Đi lẹ lên đi!
Dialogue: 0,0:00:39.45,0:00:40.69,Yukito,,0,0,0,,Ê mấy nhóc!
Dialogue: 0,0:00:41.95,0:00:45.39,Yukito,,0,0,0,,Mấy nhóc có biết món Ramen Set không hả?
Dialogue: 0,0:00:45.82,0:00:51.23,Yukito,,0,0,0,,Anh chúng mày đang đói và thèm Ramen Set muốn chết đây này.
Dialogue: 0,0:00:51.63,0:00:55.07,Yukito,,0,0,0,,Nhưng mà anh đây lại chẳng còn xu nào, cho nên...
Dialogue: 0,0:00:55.87,0:01:00.47,Yukito,,0,0,0,,Đã đến lúc cho show múa rối ngập tràn niềm vui rồi! \NCứ xem đi, trả tiền sau cũng được.
Dialogue: 0,0:01:07.95,0:01:12.68,Yukito,,0,0,0,,Thế nào? Hay chưa? Tuyệt vời chưa?
Dialogue: 0,0:01:12.88,0:01:15.09,7,,0,0,0,,Con búp bê bẩn thỉu này là sao vậy?
Dialogue: 0,0:01:15.29,0:01:16.66,2,,0,0,0,,Nhìn nó ngu ngu sao ấy.
Dialogue: 0,0:01:16.66,0:01:19.16,3,,0,0,0,,Bộ nó hổng biết làm cái gì khác sao?
Dialogue: 0,0:01:17.79,0:01:19.16,7,,0,0,0,,Ê, ê...
Dialogue: 0,0:01:19.16,0:01:21.36,Yukito,,0,0,0,,Con nít chỉ nói ra những gì chúng nghĩ thôi.
Dialogue: 0,0:01:21.79,0:01:24.56,Yukito,,0,0,0,,Nè mấy đứa, nếu muốn thì giờ trả tiền được rồi đó.
Dialogue: 0,0:01:24.56,0:01:27.33,2,,0,0,0,,Em nói thiệt nha, nhìn nó chẳng hay chút nào.
Dialogue: 0,0:01:27.33,0:01:31.17,7,,0,0,0,,Bọn này không trả tiền đâu, ngốc!
Dialogue: 0,0:01:31.37,0:01:33.67,Yukito,,0,0,0,,Tụi bây...!
Dialogue: 0,0:01:37.84,0:01:38.81,7,,0,0,0,,Chạy thôi!
Dialogue: 0,0:01:39.88,0:01:41.45,Yukito,,0,0,0,,Tụi bây đứng lại đó!
Dialogue: 0,0:01:50.36,0:01:51.89,7,,0,0,0,,Nóng quá...
Dialogue: 0,0:03:34.19,0:03:36.76,Yukito,,0,0,0,,Ramen Set!
Dialogue: 0,0:04:02.00,0:04:05.50,Titleup,,0,0,0,,{\blur10.5\pos(955.2,75.6)}Tập 1
Dialogue: 0,0:04:02.00,0:04:05.50,Titleup down,,0,0,0,,{\blur15\pos(966,312)}Cơn gió
Dialogue: 0,0:04:05.96,0:04:07.03,Misuzu,,0,0,0,,Xin chào!
Dialogue: 0,0:04:08.53,0:04:10.36,Yukito,,0,0,0,,Cô ta sao vậy kìa?
Dialogue: 0,0:04:11.23,0:04:12.76,Misuzu,,0,0,0,,Anh đi một mình hả?
Dialogue: 0,0:04:15.13,0:04:16.53,Misuzu,,0,0,0,,Hôm nay trời nóng thật.
Dialogue: 0,0:04:16.73,0:04:19.20,Yukito,,0,0,0,,Cô ta muốn gì đây?
Dialogue: 0,0:04:19.20,0:04:20.97,Yukito,,0,0,0,,Tiền ư? Mình có xu nào đâu.
Dialogue: 0,0:04:21.17,0:04:23.37,Misuzu,,0,0,0,,Anh khát nước không?
Dialogue: 0,0:04:23.58,0:04:25.21,Misuzu,,0,0,0,,Tôi mua chút gì uống nha.
Dialogue: 0,0:04:43.36,0:04:44.23,Misuzu,,0,0,0,,Đây!
Dialogue: 0,0:04:44.46,0:04:45.26,Yukito,,0,0,0,,Vất vả nhỉ.
Dialogue: 0,0:04:46.93,0:04:47.67,Misuzu,,0,0,0,,G-Gao...
Dialogue: 0,0:04:54.31,0:04:56.51,Yukito,,0,0,0,,Hương vị đào...nhão và giàu dinh dưỡng...
Dialogue: 0,0:05:02.51,0:05:05.08,Misuzu,,0,0,0,,Sao anh làm vậy?
Dialogue: 0,0:05:05.32,0:05:07.29,Yukito,,0,0,0,,Muốn trêu tôi chứ gì!
Dialogue: 0,0:05:07.49,0:05:09.49,Misuzu,,0,0,0,,Không phải đâu!
Dialogue: 0,0:05:09.89,0:05:11.92,Misuzu,,0,0,0,,Cái này ngon lắm mà.
Dialogue: 0,0:05:17.26,0:05:18.86,Misuzu,,0,0,0,,Anh có muốn ra bãi biển không?
Dialogue: 0,0:05:19.26,0:05:20.23,Yukito,,0,0,0,,Tại sao?
Dialogue: 0,0:05:20.43,0:05:22.03,Misuzu,,0,0,0,,Vì tôi muốn chơi.
Dialogue: 0,0:05:25.60,0:05:29.51,Misuzu,,0,0,0,,Ngày hôm qua có mấy đứa trẻ chơi ngoài bãi biển.
Dialogue: 0,0:05:30.01,0:05:34.61,Misuzu,,0,0,0,,Tôi cũng muốn được chơi đùa và vui vẻ như chúng.
Dialogue: 0,0:05:34.81,0:05:36.71,Misuzu,,0,0,0,,Khi ngồi cạnh anh, tôi đã nghĩ như vậy đó.
Dialogue: 0,0:05:36.92,0:05:37.95,Yukito,,0,0,0,,Em đã nhìn thấy tôi?
Dialogue: 0,0:05:38.12,0:05:40.49,Misuzu,,0,0,0,,Hôm qua anh cứ ngủ suốt luôn.
Dialogue: 0,0:05:40.49,0:05:45.52,Misuzu,,0,0,0,,Tôi đã cố trỏ trỏ để lay anh dậy mà không được...
Dialogue: 0,0:05:45.72,0:05:47.96,Yukito,,0,0,0,,Tôi đói tới mức không cử động nổi.
Dialogue: 0,0:05:48.16,0:05:49.79,Misuzu,,0,0,0,,Giờ anh đi đâu?
Dialogue: 0,0:05:49.99,0:05:50.73,Yukito,,0,0,0,,Đi làm.
Dialogue: 0,0:05:50.73,0:05:52.96,Misuzu,,0,0,0,,Làm việc gì vậy?
Dialogue: 0,0:05:53.16,0:05:55.17,Yukito,,0,0,0,,Múa rối...
Dialogue: 0,0:05:56.83,0:05:57.60,Yukito,,0,0,0,,Đâu rồi?
Dialogue: 0,0:06:00.61,0:06:02.91,Misuzu,,0,0,0,,Nó có quan trọng với anh không?
Dialogue: 0,0:06:03.11,0:06:04.58,Yukito,,0,0,0,,Có nó tôi mới kiếm ăn được.
Dialogue: 0,0:06:07.81,0:06:10.05,Yukito,,0,0,0,,Ngoài đây nóng lắm. Về nhà đi.
Dialogue: 0,0:06:14.02,0:06:14.82,Yukito,,0,0,0,,Nó kìa!
Dialogue: 0,0:06:14.82,0:06:18.32,Misuzu,,0,0,0,,Quạ ơi! Quạ ơi!
Dialogue: 0,0:06:16.79,0:06:18.32,Yukito,,0,0,0,,Tìm con qụa làm gì!?
Dialogue: 0,0:06:19.42,0:06:20.99,Misuzu,,0,0,0,,Tìm được rồi chắc anh vui lắm?
Dialogue: 0,0:06:20.99,0:06:22.13,Yukito,,0,0,0,,Ờ thì vui.
Dialogue: 0,0:06:22.13,0:06:23.36,Yukito,,0,0,0,,Cảm ơn.
Dialogue: 0,0:06:23.36,0:06:25.90,Misuzu,,0,0,0,,Giờ tụi mình đi chơi được rồi.
Dialogue: 0,0:06:26.10,0:06:27.53,Yukito,,0,0,0,,Em muốn gì?
Dialogue: 0,0:06:27.93,0:06:30.17,Yukito,,0,0,0,,Sao cứ lẽo đẽo theo tôi mãi vậy?
Dialogue: 0,0:06:30.37,0:06:32.54,Misuzu,,0,0,0,,Thì để tụi mình ra chơi ngoài bãi biển.
Dialogue: 0,0:06:32.74,0:06:41.28,Misuzu,,0,0,0,,Tụi mình sẽ rượt bắt nhau, tóe nước vào nhau, và cuối cùng mình sẽ nói "hẹn mai gặp lại".
Dialogue: 0,0:06:42.18,0:06:44.75,Yukito,,0,0,0,,Chỉ có bạn bè mới làm như thế.
Dialogue: 0,0:06:44.92,0:06:46.22,Misuzu,,0,0,0,,Phải.
Dialogue: 0,0:06:46.82,0:06:48.85,Misuzu,,0,0,0,,Thì tụi mình là bạn.
Dialogue: 0,0:06:51.22,0:06:52.26,Misuzu,,0,0,0,,Cho nên...
Dialogue: 0,0:06:53.12,0:06:54.66,Misuzu,,0,0,0,,Tôi muốn đi chơi.
Dialogue: 0,0:06:54.86,0:06:57.10,Yukito,,0,0,0,,Chúng ta thậm chí chưa biết tên nhau nữa là...
Dialogue: 0,0:06:57.10,0:06:59.53,Misuzu,,0,0,0,,Tôi là Kamio Misuzu. Anh tên gì?
Dialogue: 0,0:07:00.60,0:07:04.44,Yukito,,0,0,0,,Kunisaki Yukito... Không! Tôi còn có việc phải làm.
Dialogue: 0,0:07:06.27,0:07:09.64,Yukito,,0,0,0,,Phải kiếm ít tiền để có thứ gì đó bỏ bụng nữa.
Dialogue: 0,0:07:09.64,0:07:11.68,Misuzu,,0,0,0,,A! Hay là vầy đi...
Dialogue: 0,0:07:12.74,0:07:16.51,Yukito,,0,0,0,,Vì con bé dùng thức ăn để dụ dỗ nên tôi đã theo về nhà.
Dialogue: 0,0:07:16.98,0:07:19.22,Misuzu,,0,0,0,,Thật vui khi dùng bữa tối cùng ai đó.
Dialogue: 0,0:07:19.65,0:07:21.02,Yukito,,0,0,0,,Em luôn ở một mình à?
Dialogue: 0,0:07:21.75,0:07:25.29,Misuzu,,0,0,0,,Mẹ em về nhà rất trễ, và em không có bố.
Dialogue: 0,0:07:27.96,0:07:29.69,Misuzu,,0,0,0,,Ăn xong tụi mình đi chơi nha.
Dialogue: 0,0:07:29.83,0:07:32.53,Yukito,,0,0,0,,Không, trời tối sẽ khó tìm được chỗ nghỉ lắm.
Dialogue: 0,0:07:33.00,0:07:35.37,Misuzu,,0,0,0,,Anh vẫn chưa tìm được chỗ ở sao?
Dialogue: 0,0:07:35.90,0:07:37.90,Yukito,,0,0,0,,Chưa. Chắc lại ngủ bờ ngủ bụi ở đâu đó thôi.
Dialogue: 0,0:07:37.94,0:07:39.44,Misuzu,,0,0,0,,Vậy sao anh không ở lại đây?
Dialogue: 0,0:07:41.34,0:07:44.28,Yukito,,0,0,0,,Coi nè, chúng ta vừa mới gặp hôm nay thôi.
Dialogue: 0,0:07:44.48,0:07:48.45,Yukito,,0,0,0,,Em còn chưa biết tôi là ai hay tôi làm gì.
Dialogue: 0,0:07:48.65,0:07:50.88,Yukito,,0,0,0,,Sao dám để người như vậy ở lại?
Dialogue: 0,0:07:51.08,0:07:53.32,Yukito,,0,0,0,,Vả lại, mẹ em cũng sẽ không cho phép.
Dialogue: 0,0:07:53.72,0:07:57.72,Misuzu,,0,0,0,,Mẹ em là trùm sống tùy tiện đó, nên anh không phải lo.
Dialogue: 0,0:07:57.82,0:08:01.06,Misuzu,,0,0,0,,Mà khoan, em không nên nói về mẹ mình như vậy.
Dialogue: 0,0:08:01.26,0:08:03.63,Misuzu,,0,0,0,,Nhưng anh có thể ở lại thiệt đó.
Dialogue: 0,0:08:04.06,0:08:06.60,Yukito,,0,0,0,,Tôi mệt lắm. Chẳng còn sức đâu mà chơi với em nữa.
Dialogue: 0,0:08:06.60,0:08:09.17,Misuzu,,0,0,0,,Vậy ngày mai cũng được.
Dialogue: 0,0:08:09.17,0:08:11.80,Misuzu,,0,0,0,,Đang nghỉ hè nên em có nhiều thời gian lắm.
Dialogue: 0,0:08:11.80,0:08:12.60,Yukito,,0,0,0,,Không.
Dialogue: 0,0:08:13.04,0:08:14.61,Misuzu,,0,0,0,,G-Gao...
Dialogue: 0,0:08:19.18,0:08:22.95,Misuzu,,0,0,0,,Nè, học toán giỏi để làm gì nhỉ?
Dialogue: 0,0:08:23.58,0:08:26.88,Misuzu,,0,0,0,,Mình có bao giờ sử dụng phương trình bậc hai trong thực tế không vậy?
Dialogue: 0,0:08:26.12,0:08:26.78,Yukito,,0,0,0,,Sao tôi biết?
Dialogue: 0,0:08:27.02,0:08:30.25,Yukito,,0,0,0,,Mà tại sao tôi phải giúp em làm bài tập về nhà?
Dialogue: 0,0:08:30.89,0:08:32.16,Yukito,,0,0,0,,Đầu cao lên chút.
Dialogue: 0,0:08:33.19,0:08:35.93,Misuzu,,0,0,0,,Anh nói cứ như mẹ em ấy.
Dialogue: 0,0:08:36.33,0:08:36.93,Yukito,,0,0,0,,Vậy hả?
Dialogue: 0,0:08:42.73,0:08:44.27,Misuzu,,0,0,0,,Mẹ em về đấy.
Dialogue: 0,0:08:48.41,0:08:49.31,Yukito,,0,0,0,,Nè!
Dialogue: 0,0:08:49.31,0:08:51.51,Misuzu,,0,0,0,,Lại tông xe môtô vào nhà kho nữa rồi.
Dialogue: 0,0:08:51.71,0:08:54.15,Misuzu,,0,0,0,,Đừng lo. Lần nào cũng vậy hết mà.
Dialogue: 0,0:08:54.35,0:08:55.95,Yukito,,0,0,0,,Có chắc tôi ở được không?
Dialogue: 0,0:08:56.38,0:08:58.58,Misuzu,,0,0,0,,Um. Em sẽ xin cho.
Dialogue: 0,0:08:58.58,0:08:59.62,Haruko,,0,0,0,,KHÔNG!
Dialogue: 0,0:09:00.28,0:09:02.02,Yukito,,0,0,0,,Em đâu có nói sẽ như vầy đâu...
Dialogue: 0,0:09:02.02,0:09:06.96,Haruko,,0,0,0,,Lý nào chúng ta lại để một tên con trai qua đêm trong nhà!
Dialogue: 0,0:09:07.16,0:09:08.56,Misuzu,,0,0,0,,G-Gao...
Dialogue: 0,0:09:09.13,0:09:09.53,Misuzu,,0,0,0,,Ui...
Dialogue: 0,0:09:09.53,0:09:12.63,Haruko,,0,0,0,,Đã bao nhiêu lần mẹ bảo con ngừng nói cái câu đó?
Dialogue: 0,0:09:12.83,0:09:15.27,Haruko,,0,0,0,,Sao mà cậu quen Misuzu?
Dialogue: 0,0:09:15.93,0:09:16.83,Yukito,,0,0,0,,{\fnArial\fs54\1c&HFFFFFF&\3c&H0F0F0F&\b0\be1\pos(866.4,297)}Bạn cùng lớp
Dialogue: 0,0:09:18.30,0:09:19.37,Yukito,,0,0,0,,Bạn cùng lớp ạ.
Dialogue: 0,0:09:21.01,0:09:23.07,Haruko,,0,0,0,,Trông cậu quá già để đi học.
Dialogue: 0,0:09:23.37,0:09:24.54,Default,,0,0,0,,{\shad0\fnArial\fs54\1c&HFFFFFF&\3c&H0F0F0F&\pos(866.4,297)}Đừng có xiêu lòng vì tôi
Dialogue: 0,0:09:24.94,0:09:25.94,Yukito,,0,0,0,,Đừng xiêu lòng vì tôi.
Dialogue: 0,0:09:26.74,0:09:28.15,Haruko,,0,0,0,,Xiêu cái đầu cậu!
Dialogue: 0,0:09:28.78,0:09:33.28,Haruko,,0,0,0,,Có gan lắm. Tôi chấm cậu điểm đó.
Dialogue: 0,0:09:33.28,0:09:35.99,Misuzu,,0,0,0,,Phải đó mẹ! Yukito-san thật sự là người tốt.
Dialogue: 0,0:09:36.79,0:09:38.62,Haruko,,0,0,0,,Được rồi. Cậu có thể ở lại.
Dialogue: 0,0:09:38.82,0:09:39.69,Yukito,,0,0,0,,Cô nghiêm túc chứ?
Dialogue: 0,0:09:39.96,0:09:41.99,Haruko,,0,0,0,,Dĩ nhiên là nghiêm túc.
Dialogue: 0,0:09:42.26,0:09:44.30,Haruko,,0,0,0,,Nhưng với hai điều kiện...
Dialogue: 0,0:09:44.63,0:09:47.06,Haruko,,0,0,0,,Cậu sẽ ngủ ngoài kho, và...
Dialogue: 0,0:09:48.27,0:09:49.97,Haruko,,0,0,0,,...phải nhậu với tui.
Dialogue: 0,0:09:50.44,0:09:51.20,7,,0,0,0,,Hả?
Dialogue: 0,0:09:52.04,0:09:56.34,Haruko,,0,0,0,,Cuối cùng hắn nói thế này...
Dialogue: 0,0:09:56.97,0:10:00.48,Haruko,,0,0,0,,"Anh nghĩ anh yêu em mất rồi."
Dialogue: 0,0:10:01.08,0:10:04.72,Haruko,,0,0,0,,Thấy sao? Tôi thắng rồi, đúng không?
Dialogue: 0,0:10:04.72,0:10:09.22,Haruko,,0,0,0,,Rồi tôi mới nói rằng, "Con cá anh để sổng mất là một mỹ nhân ngư."
Dialogue: 0,0:10:09.49,0:10:12.76,Haruko,,0,0,0,,Thấy sao? Hắn hẳn là bị một cú đau điếng!
Dialogue: 0,0:10:13.02,0:10:14.23,Yukito,,0,0,0,,Sao mọi chuyện lại như thế này?
Dialogue: 0,0:10:14.43,0:10:16.03,Misuzu,,0,0,0,,Mẹ đang cao hứng ấy mà.
Dialogue: 0,0:10:16.26,0:10:20.97,Haruko,,0,0,0,,Tươi tỉnh lên nào, kẻ ăn nhờ ở đậu. \NCậu cũng phải làm trò gì đi chứ.
Dialogue: 0,0:10:21.17,0:10:22.10,Yukito,,0,0,0,,Mắt tui!
Dialogue: 0,0:10:22.10,0:10:23.13,Misuzu,,0,0,0,,Yukito-san!
Dialogue: 0,0:10:24.20,0:10:26.77,Yukito,,0,0,0,,Vậy bà muốn tui làm gì?
Dialogue: 0,0:10:27.00,0:10:31.58,Haruko,,0,0,0,,Gì cũng được! Một lời tỏ tình gợi cảm, hoặc vài trò tiêu khiển gì đó.
Dialogue: 0,0:10:31.58,0:10:33.44,Yukito,,0,0,0,,Thôi được rồi...
Dialogue: 0,0:10:36.78,0:10:38.62,Misuzu,,0,0,0,,A, là con búp bê đó.
Dialogue: 0,0:10:43.96,0:10:45.39,Misuzu,,0,0,0,,Wow. Tuyệt thật!
Dialogue: 0,0:10:46.06,0:10:48.19,Yukito,,0,0,0,,Tôi kiếm tiền bằng màn trình diễn này.
Dialogue: 0,0:10:48.73,0:10:51.93,Yukito,,0,0,0,,Mẹ của tôi cũng du hành khắp nơi và kiếm sống bằng việc này.
Dialogue: 0,0:10:53.33,0:10:54.93,Haruko,,0,0,0,,Hay ở chỗ nào vậy?
Dialogue: 0,0:10:56.97,0:10:59.57,Haruko,,0,0,0,,Cậu không có khiếu rồi.
Dialogue: 0,0:10:59.70,0:11:02.67,Misuzu,,0,0,0,,Nhưng nó vẫn hay ở chỗ không có mánh khóe nào cả.
Dialogue: 0,0:11:03.07,0:11:04.41,Haruko,,0,0,0,,Đâu quan trọng.
Dialogue: 0,0:11:04.81,0:11:08.65,Haruko,,0,0,0,,Cho dù là thấy sợi dây thì nó cũng phải \Nhấp dẫn hơn may ra mẹ mới thích được.
Dialogue: 0,0:11:09.15,0:11:09.68,Yukito,,0,0,0,,Tui đi ngủ.
Dialogue: 0,0:11:09.95,0:11:12.68,Misuzu,,0,0,0,,Mẹ làm anh ấy tự ái phải bỏ đi ngủ rồi kìa!
Dialogue: 0,0:11:13.92,0:11:17.89,Haruko,,0,0,0,,Đừng buồn nếu cậu không có tài. Cứ uống vào là quên sầu ngay ấy mà!
Dialogue: 0,0:11:20.09,0:11:23.33,Haruko,,0,0,0,,Tên tôi là Haruko, Kamio Haruko.
Dialogue: 0,0:11:23.90,0:11:25.60,Yukito,,0,0,0,,Cốc nữa được không, bà cô?
Dialogue: 0,0:11:26.40,0:11:29.47,Haruko,,0,0,0,,Tôi đã nói tên để cậu khỏi phải gọi như thế rồi mà!
Dialogue: 0,0:11:29.73,0:11:31.64,Haruko,,0,0,0,,Biết điều chút đi chứ!
Dialogue: 0,0:11:34.11,0:11:36.24,Haruko,,0,0,0,,Nói xem, cậu bỏ nhà đi bụi hả?
Dialogue: 0,0:11:36.81,0:11:38.11,Yukito,,0,0,0,,Tôi du hành khắp nơi.
Dialogue: 0,0:11:38.94,0:11:41.58,Haruko,,0,0,0,,Cậu có ước mơ hay đại loại thế à?
Dialogue: 0,0:11:41.71,0:11:42.65,Yukito,,0,0,0,,Có lẽ.
Dialogue: 0,0:11:43.28,0:11:44.95,Haruko,,0,0,0,,Trông cậu còn quá trẻ để...
Dialogue: 0,0:11:45.12,0:11:46.35,Yukito,,0,0,0,,Trẻ hơn cô nhiều.
Dialogue: 0,0:11:49.65,0:11:51.56,Haruko,,0,0,0,,Cậu vui tính thật.
Dialogue: 0,0:11:51.62,0:11:52.29,Yukito,,0,0,0,,Vậy sao?
Dialogue: 0,0:11:52.29,0:11:55.56,Haruko,,0,0,0,,Tôi giỏi nhìn người lắm đó.
Dialogue: 0,0:11:55.73,0:11:59.06,Haruko,,0,0,0,,Tôi không ngại cho cậu ở lại ít lâu, \Nnhưng có một chuyện tôi muốn nhờ.
Dialogue: 0,0:12:00.30,0:12:02.27,Haruko,,0,0,0,,Cậu có thể trông chừng con bé không?
Dialogue: 0,0:12:03.73,0:12:06.54,Haruko,,0,0,0,,Tôi lo cho nó lắm.
Dialogue: 0,0:12:06.97,0:12:11.21,Haruko,,0,0,0,,Nó luôn bất cẩn và làm bất cứ gì nó thấy thích.
Dialogue: 0,0:12:11.21,0:12:12.54,Yukito,,0,0,0,,Muốn tôi làm vú em à?
Dialogue: 0,0:12:12.58,0:12:17.52,Haruko,,0,0,0,,Và cậu cũng có thể chỉnh con bé mỗi khi nó nói "Gao".
Dialogue: 0,0:12:17.82,0:12:21.05,Haruko,,0,0,0,,Con bé nói thế là lúc nó sắp khóc hay khi nó bối rối không biết làm gì.
Dialogue: 0,0:12:22.22,0:12:24.86,Haruko,,0,0,0,,Nó nghĩ làm như vậy sẽ bắt chước được khủng long.
Dialogue: 0,0:12:25.16,0:12:29.69,Haruko,,0,0,0,,Từ bé nó đã yêu thích khủng long và bắt đầu "kêu" lên như thế.
Dialogue: 0,0:12:30.03,0:12:32.83,Haruko,,0,0,0,,Nó hãy còn là một đứa trẻ.
Dialogue: 0,0:12:42.64,0:12:44.88,Yukito,,0,0,0,,Tôi tưởng em đang nghỉ hè.
Dialogue: 0,0:12:45.84,0:12:47.61,Misuzu,,0,0,0,,Em phải tham dự lớp học hè.
Dialogue: 0,0:12:48.35,0:12:49.75,Yukito,,0,0,0,,Haruko đi rồi à?
Dialogue: 0,0:12:50.08,0:12:52.15,Misuzu,,0,0,0,,Um, mẹ đi từ sớm.
Dialogue: 0,0:12:52.85,0:12:55.35,Misuzu,,0,0,0,,Lâu lắm rồi em mới ăn sáng cùng ai đó.
Dialogue: 0,0:12:56.59,0:12:58.86,Misuzu,,0,0,0,,Hôm nay anh định làm gì, Yukito-san?
Dialogue: 0,0:12:58.86,0:13:01.46,Yukito,,0,0,0,,Trước hết, tôi sẽ đưa em tới trường.
Dialogue: 0,0:13:01.46,0:13:06.73,Yukito,,0,0,0,,Haruko đã nhờ tôi trông chừng để em\N khỏi làm những chuyện ngốc nghếch.
Dialogue: 0,0:13:07.16,0:13:09.77,Misuzu,,0,0,0,,Mẹ chẳng tin tưởng em gì hết.
Dialogue: 0,0:13:10.30,0:13:11.74,Misuzu,,0,0,0,,Gao!
Dialogue: 0,0:13:12.17,0:13:14.64,Misuzu,,0,0,0,,Xong rồi! Đây là bản đồ của thị trấn!
Dialogue: 0,0:13:14.77,0:13:16.37,Yukito,,0,0,0,,Nhanh quá vậy.
Dialogue: 0,0:13:16.64,0:13:22.15,Misuzu,,0,0,0,,Anh có thể dùng nó cho công việc, nhìn nó\N anh sẽ biết nơi nào có nhiều người.
Dialogue: 0,0:13:22.95,0:13:24.75,Yukito,,0,0,0,,Cảm ơn.
Dialogue: 0,0:13:25.78,0:13:29.59,Misuzu,,0,0,0,,Sắp trễ rồi! Misuzu-chin gặp rắc rối!
Dialogue: 0,0:13:33.39,0:13:36.46,Yukito,,0,0,0,,Tan học tôi sẽ đón em, đợi ở đây nhé?
Dialogue: 0,0:13:36.46,0:13:36.93,Misuzu,,0,0,0,,Um!
Dialogue: 0,0:13:42.33,0:13:42.80,Misuzu,,0,0,0,,V!
Dialogue: 0,0:13:49.91,0:13:51.28,Yukito,,0,0,0,,Cái gì đây?
Dialogue: 0,0:13:52.11,0:13:54.65,Yukito,,0,0,0,,Thế giới trong mắt con bé là vầy sao?
Dialogue: 0,0:14:01.19,0:14:02.49,Yukito,,0,0,0,,Mày là cái giống gì đây?
Dialogue: 0,0:14:03.95,0:14:06.62,Yukito,,0,0,0,,Một loại thần thú của thị trấn này hả?
Dialogue: 0,0:14:08.29,0:14:13.66,Yukito,,0,0,0,,Nếu thật như thế thì tao sẽ làm gì đó cho mày rồi mày sẽ trả ơn, giống trong truyện cổ tích vậy.
Dialogue: 0,0:14:15.47,0:14:17.70,Yukito,,0,0,0,,Được rồi, lại đây. Cho mày xem cái này nè.
Dialogue: 0,0:14:22.94,0:14:27.85,Yukito,,0,0,0,,Thấy sao? Màn trình diễn quá tuyệt đến mức muốn trả ơn cho tao hả?
Dialogue: 0,0:14:32.58,0:14:33.15,Yukito,,0,0,0,,Ê!
Dialogue: 0,0:14:35.79,0:14:37.32,Yukito,,0,0,0,,Đợi đã!
Dialogue: 0,0:14:52.90,0:14:57.24,Yukito,,0,0,0,,Chịu thua đi, con quái vật ngoài hành tinh kia!
Dialogue: 0,0:14:59.34,0:15:00.78,Yukito,,0,0,0,,Đừng hòng chạy thoát!
Dialogue: 0,0:15:06.95,0:15:08.32,Kano,,0,0,0,,Anh đang làm gì vậy?
Dialogue: 0,0:15:13.52,0:15:17.73,Yukito,,0,0,0,,Có con quái vật ngoài hành tinh cướp mất búp bê của tôi.
Dialogue: 0,0:15:18.83,0:15:22.90,Kano,,0,0,0,,Anh nói nó hả? Potato đâu phải là sinh vật ngoài hành tinh.
Dialogue: 0,0:15:22.90,0:15:25.34,Kano,,0,0,0,,Nó chỉ là chú cún đi lang thang của nhà hàng xóm thôi.
Dialogue: 0,0:15:25.54,0:15:28.27,Yukito,,0,0,0,,Vậy ra nó là chó thật à?
Dialogue: 0,0:15:35.28,0:15:39.35,Kano,,0,0,0,,Tôi hiểu rồi. Thật xin lỗi anh.
Dialogue: 0,0:15:39.35,0:15:40.72,Yukito,,0,0,0,,Sao em phải xin lỗi?
Dialogue: 0,0:15:41.02,0:15:46.56,Kano,,0,0,0,,Potato nói nó cướp con búp bê của anh đến tận đây chỉ vì muốn anh chơi với nó thôi.
Dialogue: 0,0:15:47.06,0:15:49.19,Yukito,,0,0,0,,Em hiểu nó à?
Dialogue: 0,0:15:49.19,0:15:51.06,Kano,,0,0,0,,Um. Bọn này là bạn thân nhất mà!
Dialogue: 0,0:15:51.33,0:15:52.93,Kano,,0,0,0,,Ha, Potato?
Dialogue: 0,0:15:53.80,0:15:57.97,Yukito,,0,0,0,,Thế giới đầy rẫy những chuyện kỳ bí.
Dialogue: 0,0:15:59.94,0:16:00.81,Yukito,,0,0,0,,Cảm ơn.
Dialogue: 0,0:16:02.11,0:16:04.04,Yukito,,0,0,0,,Em bị thương à?
Dialogue: 0,0:16:04.04,0:16:06.94,Kano,,0,0,0,,Ô, cái này hả? à...
Dialogue: 0,0:16:08.01,0:16:10.15,Kano,,0,0,0,,Không nói! Là bí mật!
Dialogue: 0,0:16:13.92,0:16:16.42,Kano,,0,0,0,,Tôi là Kirishima Kano. Còn anh?
Dialogue: 0,0:16:16.65,0:16:17.96,Yukito,,0,0,0,,Kunisaki Yukito.
Dialogue: 0,0:16:18.26,0:16:20.06,Kano,,0,0,0,,Giờ anh đang rảnh hả?
Dialogue: 0,0:16:20.29,0:16:20.72,Yukito,,0,0,0,,Ờ.
Dialogue: 0,0:16:21.93,0:16:25.23,Kano,,0,0,0,,Vậy tôi chỉ định anh là "Công dân hành tinh Lười Biếng" số 2!
Dialogue: 0,0:16:25.26,0:16:26.53,Yukito,,0,0,0,,Ai số một?
Dialogue: 0,0:16:28.00,0:16:31.30,Kano,,0,0,0,,Tôi. Còn Potato là số 3.
Dialogue: 0,0:16:32.54,0:16:34.91,Yukito,,0,0,0,,Thế người của hành tinh Lười Biếng làm gì?
Dialogue: 0,0:16:35.21,0:16:39.58,Kano,,0,0,0,,Chẳng làm gì hết! Đó là định mệnh của người dân Hành tinh Lười biếng.
Dialogue: 0,0:16:39.58,0:16:42.15,Kano,,0,0,0,,Ha, công dân Lười Biếng Potato?
Dialogue: 0,0:16:44.62,0:16:48.32,Kano,,0,0,0,,Giờ tôi phải đến trường. Tạm biệt nhé!
Dialogue: 0,0:16:48.82,0:16:51.06,Yukito,,0,0,0,,Tôi tưởng em ở Hành tinh Lười Biếng mà.
Dialogue: 0,0:16:51.06,0:16:54.56,Kano,,0,0,0,,Anh tin thật sao? Con nít quá đi.
Dialogue: 0,0:16:55.76,0:16:56.56,Kano,,0,0,0,,Tạm biệt!
Dialogue: 0,0:16:57.73,0:17:01.03,Yukito,,0,0,0,,Hình như ai mặc bộ đồng phục đó đều kỳ quặc cả.
Dialogue: 0,0:17:02.17,0:17:02.77,Kano,,0,0,0,,Nè!
Dialogue: 0,0:17:04.87,0:17:05.60,Yukito,,0,0,0,,Chuyện gì?
Dialogue: 0,0:17:05.94,0:17:09.21,Kano,,0,0,0,,Đã bao giờ anh muốn sử dụng phép thuật chưa?
Dialogue: 0,0:17:11.51,0:17:12.24,Yukito,,0,0,0,,Hả?
Dialogue: 0,0:17:14.45,0:17:16.61,Kano,,0,0,0,,Bị hù rồi! Tạm biệt!
Dialogue: 0,0:17:18.62,0:17:19.48,Yukito,,0,0,0,,Phép thuật?
Dialogue: 0,0:17:29.63,0:17:33.26,Misuzu,,0,0,0,,Yukito-san! Công việc thế nào?
Dialogue: 0,0:17:33.93,0:17:35.63,Yukito,,0,0,0,,Thắng lớn rồi!
Dialogue: 0,0:17:36.97,0:17:37.97,Misuzu,,0,0,0,,Thật sao?
Dialogue: 0,0:17:38.34,0:17:39.90,Yukito,,0,0,0,,Xin lỗi, tôi xạo đó.
Dialogue: 0,0:17:41.04,0:17:44.34,Yukito,,0,0,0,,Tìm chỗ đông người kiếm ăn mới dễ.
Dialogue: 0,0:17:44.68,0:17:48.78,Yukito,,0,0,0,,Sao giờ cao điểm mà vắng hoe thế này?
Dialogue: 0,0:17:49.15,0:17:52.08,Misuzu,,0,0,0,,Tuyến đường của trạm xe này đã ngừng hoạt động rồi.
Dialogue: 0,0:17:52.12,0:17:53.68,Yukito,,0,0,0,,Sao không nói sớm?
Dialogue: 0,0:17:53.98,0:17:55.35,Misuzu,,0,0,0,,G-Gao...
Dialogue: 0,0:17:56.12,0:17:56.85,Misuzu,,0,0,0,,Ui da...
Dialogue: 0,0:17:57.39,0:17:59.49,Misuzu,,0,0,0,,Sao đánh em?
Dialogue: 0,0:18:00.42,0:18:05.10,Yukito,,0,0,0,,Haruko bảo tôi chỉnh em bất cứ khi nào em nói câu đó.
Dialogue: 0,0:18:06.33,0:18:07.40,Misuzu,,0,0,0,,Dễ thương quá...
Dialogue: 0,0:18:12.94,0:18:14.20,Misuzu,,0,0,0,,Tohno-san.
Dialogue: 0,0:18:15.14,0:18:16.41,Yukito,,0,0,0,,Em biết cô ta hả?
Dialogue: 0,0:18:16.44,0:18:17.14,Misuzu,,0,0,0,,Um.
Dialogue: 0,0:18:20.48,0:18:22.21,Yukito,,0,0,0,,Sợ cái gì?
Dialogue: 0,0:18:24.78,0:18:25.88,Misuzu,,0,0,0,,Xin chào!
Dialogue: 0,0:18:27.89,0:18:30.55,Minagi,,0,0,0,,Chào. Thật là trùng hợp.
Dialogue: 0,0:18:30.72,0:18:31.76,Misuzu,,0,0,0,,A, phải đó.
Dialogue: 0,0:18:32.12,0:18:33.86,Misuzu,,0,0,0,,Trùng hợp thật.
Dialogue: 0,0:18:34.69,0:18:35.49,Misuzu,,0,0,0,,Làm tớ bất ngờ...
Dialogue: 0,0:18:37.56,0:18:39.00,Misuzu,,0,0,0,,Cậu đang làm gì vậy?
Dialogue: 0,0:18:39.43,0:18:41.17,Minagi,,0,0,0,,Tắm nắng.
Dialogue: 0,0:18:42.47,0:18:45.67,Minagi,,0,0,0,,Đùa thôi. Chiều rồi còn gì.
Dialogue: 0,0:18:46.94,0:18:48.64,Yukito,,0,0,0,,Này, cô ta sao vậy?
Dialogue: 0,0:18:48.71,0:18:53.04,Misuzu,,0,0,0,,Tohno Minagi-san. Bạn cùng lớp với em, bạn ấy rất thông minh.
Dialogue: 0,0:18:53.04,0:18:56.15,Misuzu,,0,0,0,,Thành tích học tập cao nhất lớp, \Nlà hội trưởng câu lạc bộ thiên văn.
Dialogue: 0,0:18:56.45,0:19:01.09,Minagi,,0,0,0,,Cứ gọi tớ là Tohno cũng được.
Dialogue: 0,0:19:02.12,0:19:03.55,Michiru,,0,0,0,,Minagi!
Dialogue: 0,0:19:08.99,0:19:12.60,Misuzu,,0,0,0,,Wa! Yukito-san tung bay như gió kìa!
Dialogue: 0,0:19:13.20,0:19:19.10,Michiru,,0,0,0,,Mình thổi bong bóng xà phòng đi! Em đang rất có hứng đây! Đi chị!
Dialogue: 0,0:19:19.10,0:19:21.61,Misuzu,,0,0,0,,Đây là em gái của cậu à?
Dialogue: 0,0:19:22.14,0:19:26.81,Michiru,,0,0,0,,Không phải. Em là bạn thân nhất của Minagi. Chị là ai?
Dialogue: 0,0:19:26.84,0:19:29.18,Misuzu,,0,0,0,,Chị là bạn cùng lớp.
Dialogue: 0,0:19:29.41,0:19:31.68,Yukito,,0,0,0,,Đau quá trời quá đất...
Dialogue: 0,0:19:32.05,0:19:35.05,Michiru,,0,0,0,,Gì? Anh cũng là bạn cùng lớp của Minagi hả?
Dialogue: 0,0:19:35.05,0:19:38.56,Yukito,,0,0,0,,Ta là một người khách qua đường vô tội bị mi tông trúng.
Dialogue: 0,0:19:42.03,0:19:46.86,Michiru,,0,0,0,,Em biết rồi! Minagi, hắn là tên bắt cóc biến thái tới để bắt tụi mình đó!
Dialogue: 0,0:19:46.86,0:19:48.30,Misuzu,,0,0,0,,Mình cũng ở bên này sao?
Dialogue: 0,0:19:48.30,0:19:50.03,Yukito,,0,0,0,,Mi gọi ai là tên bắt cóc hả?
Dialogue: 0,0:19:50.03,0:19:53.50,Michiru,,0,0,0,,Ôi không! Hắn đang kích động! Các thiếu nữ gặp nguy rồi!
Dialogue: 0,0:19:55.27,0:19:56.87,Misuzu,,0,0,0,,Hình như là đau lắm.
Dialogue: 0,0:19:58.21,0:20:00.34,Minagi,,0,0,0,,Kamio-san, người này là...?
Dialogue: 0,0:20:00.34,0:20:05.05,Misuzu,,0,0,0,,Anh ấy là Kunisaki Yukito-san, khách du hành, \Ngiờ anh ấy đang ở nhà tớ.
Dialogue: 0,0:20:05.18,0:20:06.45,Minagi,,0,0,0,,Khách du hành...
Dialogue: 0,0:20:06.78,0:20:10.45,Michiru,,0,0,0,,Biến thái mà còn ăn bám nữa! Ông hết hy vọng rồi!
Dialogue: 0,0:20:24.00,0:20:27.40,Minagi,,0,0,0,,Kamio-san, bọn tớ phải đi đây.
Dialogue: 0,0:20:27.94,0:20:30.81,Michiru,,0,0,0,,Nhưng em cuối cùng mới tìm ra bí quyết thổi bong bóng!
Dialogue: 0,0:20:30.81,0:20:33.54,Michiru,,0,0,0,,Em vẫn còn muốn chơi! Kamikami cũng có thể chơi cùng!
Dialogue: 0,0:20:33.58,0:20:35.41,Misuzu,,0,0,0,,Kamikami? Chị hả?
Dialogue: 0,0:20:35.98,0:20:39.35,Minagi,,0,0,0,,Trời tối rồi, ngày mai chúng ta thử lại cũng được.
Dialogue: 0,0:20:39.38,0:20:41.72,Minagi,,0,0,0,,Chị sẽ làm bữa trưa cho em.
Dialogue: 0,0:20:44.66,0:20:47.26,Michiru,,0,0,0,,Tạm biệt, Kamiya!
Dialogue: 0,0:20:48.43,0:20:49.43,Misuzu,,0,0,0,,Bye bye!
Dialogue: 0,0:20:49.43,0:20:50.96,Michiru,,0,0,0,,Kunisaki Yukito!
Dialogue: 0,0:20:51.10,0:20:51.60,Yukito,,0,0,0,,Gì?
Dialogue: 0,0:20:51.96,0:20:54.16,Michiru,,0,0,0,,Biến đi cho khuất mắt!
Dialogue: 0,0:20:55.63,0:20:57.67,Yukito,,0,0,0,,Nói gì hả...
Dialogue: 0,0:20:58.27,0:21:01.77,Michiru,,0,0,0,,Ngày mai chị làm hamburger cho em nha?
Dialogue: 0,0:21:01.77,0:21:02.51,Minagi,,0,0,0,,Um.
Dialogue: 0,0:21:02.51,0:21:04.41,Michiru,,0,0,0,,Thật không? Hay quá!
Dialogue: 0,0:21:04.91,0:21:07.01,Yukito,,0,0,0,,Bộ tôi có thù gì với con nhóc đó hả?
Dialogue: 0,0:21:07.88,0:21:08.95,Misuzu,,0,0,0,,Em không biết.
Dialogue: 0,0:21:11.92,0:21:15.19,Yukito,,0,0,0,,Rốt cuộc, một yên cũng chẳng kiếm được.
Dialogue: 0,0:21:16.52,0:21:19.26,Yukito,,0,0,0,,Ngày hôm qua em cũng như thế này hả?
Dialogue: 0,0:21:19.69,0:21:24.19,Misuzu,,0,0,0,,Từ bé em đã luôn nghĩ về bầu trời.
Dialogue: 0,0:21:25.03,0:21:25.73,Yukito,,0,0,0,,Tại sao?
Dialogue: 0,0:21:26.23,0:21:27.53,Misuzu,,0,0,0,,Chẳng biết nữa.
Dialogue: 0,0:21:27.90,0:21:33.20,Misuzu,,0,0,0,,Chỉ là em có cảm giác rằng một phần khác \Ncủa mình đang ở một nơi nào đó.
Dialogue: 0,0:21:33.40,0:21:38.58,Misuzu,,0,0,0,,Thật không lãng mạn sao nếu chính em ở trên bầu trời?
Dialogue: 0,0:21:38.58,0:21:43.25,Misuzu,,0,0,0,,Ngắm nhìn vạn vật từ trên cao hẳn là rất tuyệt.
Dialogue: 0,0:21:43.31,0:21:47.25,Misuzu,,0,0,0,,Mọi thứ trên mặt đất sẽ hóa tí hon.
Dialogue: 0,0:21:47.52,0:21:51.52,Misuzu,,0,0,0,,Khiến em cảm thấy rất dễ chịu.
Dialogue: 0,0:21:55.69,0:21:58.43,Yukito,,0,0,0,,Misuzu... em...
Dialogue: 0,0:21:59.50,0:22:08.67,Yukito,,0,0,0,,{\fad(0,300)}Đó là khởi đầu của một mùa hè tưởng chừng chóng vánh tựa ánh sao, nhưng dường như lại kéo dài đến vô tận.
Dialogue: 0,0:23:41.10,0:23:45.37,Yukito,,0,0,0,,{\fad(200,200)}Có thể tôi đang kiếm tìm phần kia con người em.
Dialogue: 0,0:23:45.50,0:23:50.17,Haruko,,0,0,0,,{\fad(200,200)}Tôi không đủ sức để làm cha làm mẹ. \NLẽ ra tôi nên sống một mình.
Dialogue: 0,0:23:51.38,0:23:55.51,Misuzu,,0,0,0,,{\fad(200,200)}Em có một giấc mơ. Một giấc mơ huyền bí về bầu trời.
Dialogue: 0,0:23:55.95,0:24:00.65,Misuzu,,0,0,0,,{\fad(200,200)}Em đã ở trên bầu trời và đó là một thế giới em chưa bao giờ nhìn thấy.
Dialogue: 0,0:24:00.75,0:24:03.25,Misuzu,,0,0,0,,{\fad(200,200)}Cảnh vật trải dài ra mênh mông trước tầm mắt.
Dialogue: 0,0:24:04.05,0:24:08.99,Yukito,,0,0,0,,{\fad(200,200)}Trong giấc mơ em có cánh chứ?


