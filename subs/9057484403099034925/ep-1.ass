Dialogue: 10,0:00:55.70,0:00:58.98,Default,Tsumiki,0000,0000,0000,,Ch... Chào...
Dialogue: 10,0:00:59.85,0:01:04.25,Default,Tsumiki,0000,0000,0000,,Chào... Chào...
Dialogue: 10,0:01:04.99,0:01:09.70,Default,Tsumiki,0000,0000,0000,,Chào buổi sáng... I-Io...
Dialogue: 10,0:01:09.70,0:01:12.36,Default,Io,0000,0000,0000,,Chào buổi sáng, Tsumiki.
Dialogue: 10,0:01:18.62,0:01:21.22,Default,Tsumiki,0000,0000,0000,,Chào... Chào buổi sáng.
Dialogue: 10,0:01:21.67,0:01:22.48,Default,Io,0000,0000,0000,,Gì thế?
Dialogue: 10,0:01:22.48,0:01:24.23,Default,Tsumiki,0000,0000,0000,,K-Không có gì...
Dialogue: 10,0:01:24.94,0:01:27.70,Default,Tsumiki,0000,0000,0000,,Hiếm khi thấy cậu đi xe đạp đó.
Dialogue: 10,0:01:27.70,0:01:30.27,Default,Io,0000,0000,0000,,Sáng nay mình dậy hơi muộn nên...
Dialogue: 10,0:01:30.27,0:01:31.44,Default,Tsumiki,0000,0000,0000,,Vậy à.
Dialogue: 10,0:01:34.13,0:01:36.03,Default,Tsumiki,0000,0000,0000,,Cậu không đi xe đạp tiếp à?
Dialogue: 10,0:01:36.56,0:01:38.49,Default,Io,0000,0000,0000,,Hai người đi chung xe đạp là vi phạm đấy.
Dialogue: 10,0:01:38.49,0:01:41.75,Default,Tsumiki,0000,0000,0000,,M-Mình không có ý đó...
Dialogue: 10,0:01:43.44,0:01:46.58,Default,Io,0000,0000,0000,,Yên tâm từ đây đi bộ tới trường vẫn kịp giờ mà.
Dialogue: 10,0:01:47.25,0:01:49.58,Default,Tsumiki,0000,0000,0000,,Đ-Được rồi...
Dialogue: 10,0:03:51.55,0:03:54.62,Default,Mayoi,0000,0000,0000,,Chào buổi sáng! Io-san, Tsumiki-san!
Dialogue: 10,0:03:54.62,0:03:56.04,Default,Hime,0000,0000,0000,,Chào buổi sáng.
Dialogue: 10,0:03:57.15,0:03:59.93,Default,Io,0000,0000,0000,,Chào buổi sáng, Mayoi, Hime.
Dialogue: 10,0:03:59.93,0:04:00.80,Default,Tsumiki,0000,0000,0000,,Chào buổi sáng.
Dialogue: 10,0:04:01.19,0:04:03.92,Default,Mayoi,0000,0000,0000,,Io-san, hôm nay cậu đi xe đạp à?
Dialogue: 10,0:04:03.92,0:04:05.43,Default,Io,0000,0000,0000,,À do sáng nay mình dậy hơi muộn.
Dialogue: 10,0:04:05.43,0:04:09.30,Default,Io,0000,0000,0000,,Trời khá lạnh nên mình nghĩ đến lớp học càng sớm càng tốt.
Dialogue: 10,0:04:09.30,0:04:13.91,Default,Mayoi,0000,0000,0000,,Cứ tới mùa này là không ai muốn ở ngoài trời quá lâu.
Dialogue: 10,0:04:13.91,0:04:17.92,Default,Hime,0000,0000,0000,,Thời tiết vào hè và đông thật khó chịu.
Dialogue: 10,0:04:17.92,0:04:18.81,Default,Mayoi,0000,0000,0000,,Hử?
Dialogue: 10,0:04:19.18,0:04:22.04,Default,Mayoi,0000,0000,0000,,Tsumiki, câu không đem theo áo khoác à?
Dialogue: 10,0:04:22.04,0:04:24.57,Default,Tsumiki,0000,0000,0000,,Nó vẫn còn ở tiệm giặt ủi...
Dialogue: 10,0:04:24.57,0:04:28.21,Default,Hime,0000,0000,0000,,Cậu cũng đâu chịu lạnh được mà, phải không?
Dialogue: 10,0:04:28.21,0:04:28.82,Default,Tsumiki,0000,0000,0000,,Ừm.
Dialogue: 10,0:04:29.23,0:04:33.32,Default,Mayoi,0000,0000,0000,,Do đó cậu mới cố túm lấy áo của Io-san ha?
Dialogue: 10,0:04:34.86,0:04:36.37,Default,Tsumiki,0000,0000,0000,,Vậy cậu đã thấy...
Dialogue: 10,0:04:36.37,0:04:39.64,Default,Mayoi,0000,0000,0000,,Tụi mình thấy cậu nhìn chằm chằm cậu ấy!
Dialogue: 10,0:04:41.30,0:04:42.72,Default,Mayoi,0000,0000,0000,,Này, Io-san!
Dialogue: 10,0:04:42.72,0:04:47.59,Default,Mayoi,0000,0000,0000,,Hãy bỏ Tsumiki-san tội nghiệp đang lạnh run vào giỏ xe và chở nhỏ tới một nơi thật ấm áp?
Dialogue: 10,0:04:50.21,0:04:51.39,Default,Io,0000,0000,0000,,Giỏ xe của mình?
Dialogue: 10,0:04:51.39,0:04:52.92,Default,Tsumiki,0000,0000,0000,,Không cần đâu.
Dialogue: 10,0:04:54.99,0:04:56.51,Default,Io,0000,0000,0000,,Thế này à?
Dialogue: 10,0:05:00.70,0:05:02.54,Default,Hime,0000,0000,0000,,D-Dễ thương quá!
Dialogue: 10,0:05:02.54,0:05:05.03,Default,Tsumiki,0000,0000,0000,,Ngay cả khi là giỏ xe nó cũng là vi phạm ...
Dialogue: 10,0:05:06.64,0:05:08.56,Default,Io,0000,0000,0000,,Lạnh à, Tsumiki?
Dialogue: 10,0:05:08.56,0:05:10.49,Default,Tsumiki,0000,0000,0000,,Mình không sao đâu.
Dialogue: 10,0:05:10.49,0:05:12.41,Default,Io,0000,0000,0000,,Nè, choàng khăn của mình vào đi.
Dialogue: 10,0:05:12.41,0:05:14.04,Default,Tsumiki,0000,0000,0000,,Nó sẽ dày hơn nên...
Dialogue: 10,0:05:14.04,0:05:16.48,Default,Hime,0000,0000,0000,,Io thật là tốt bụng.
Dialogue: 10,0:05:16.48,0:05:19.04,Default,Mayoi,0000,0000,0000,,Khăn choàng của cậu hơi quá khổ với cậu ấy đấy.
Dialogue: 10,0:05:19.81,0:05:20.50,Default,Io,0000,0000,0000,,À rế?
Dialogue: 10,0:05:20.50,0:05:21.54,Default,Mayoi,0000,0000,0000,,Sặc! {would be the literal line... perhaps a "what the hell?!" or similar might be better}
Dialogue: 10,0:05:29.68,0:05:32.27,Default,Mayoi,0000,0000,0000,,Hình như là Kikue-sensei!
Dialogue: 10,0:05:33.17,0:05:35.41,Default,Tsumiki,0000,0000,0000,,Có vẻ như hôm nay cô đến sớm.
Dialogue: 10,0:05:35.41,0:05:38.59,Default,Kikue,0000,0000,0000,,Ara, các em, chào buổi sáng-
Dialogue: 10,0:05:42.19,0:05:44.25,Default,Mayoi,0000,0000,0000,,Cổ trượt vỏ chuối rồi...
Dialogue: 10,0:05:45.90,0:05:47.23,Default,Io,0000,0000,0000,,Ngạc nhiên thật.
Dialogue: 10,0:05:47.23,0:05:48.70,Default,Tsumiki,0000,0000,0000,,Các cậu không lo chút nào à?
Dialogue: 10,0:05:49.26,0:05:51.56,Default,Io,0000,0000,0000,,Nhưng cố ấy té thật điệu nghệ.
Dialogue: 10,0:05:51.56,0:05:55.20,Default,Mayoi,0000,0000,0000,,Cú đáp đất cực tài tình và duyên dáng..{滑るまでの一連にムダがなかった}
Dialogue: 10,0:05:55.58,0:05:59.14,Default,Mayoi,0000,0000,0000,,Không biết có người nào làm được như thế không ?
Dialogue: 10,0:05:59.14,0:06:02.64,Default,Io,0000,0000,0000,,Ờ, người duy nhất mình nghĩ tới...
Dialogue: 10,0:06:02.64,0:06:03.79,Default,Io,0000,0000,0000,,chỉ có thể là Hime.
Dialogue: 10,0:06:04.46,0:06:08.86,Default,Hime,0000,0000,0000,,Không thể nào! Có bao giờ mình trượt vỏ chuối đâu!
Dialogue: 10,0:06:08.86,0:06:10.69,Default,Kikue,0000,0000,0000,,Sáng nay thật xui mà...
Dialogue: 10,0:06:10.69,0:06:13.66,Default,Hime,0000,0000,0000,,Sensei, cô không sao...
Dialogue: 10,0:06:12.00,0:06:13.66,Alternative,Tsumiki,0000,0000,0000,,Cẩn thận.
Dialogue: 10,0:06:13.66,0:06:15.66,Default,,0000,0000,0000,,chứ?!
Dialogue: 10,0:06:17.35,0:06:19.96,Default,Mayoi,0000,0000,0000,,Hime-chi, cậu làm người khác phải sợ thật mà.
Dialogue: 10,0:06:19.96,0:06:22.52,Default,Io,0000,0000,0000,,Mình lại được chứng kiến lần nữa.
Dialogue: 10,0:06:22.52,0:06:25.00,Default,Tsumiki,0000,0000,0000,,Chắc là vũng nước bị đóng băng.
Dialogue: 10,0:06:25.00,0:06:26.46,Default,Mayoi,0000,0000,0000,,Hime-chi!
Dialogue: 10,0:06:26.46,0:06:27.40,Default,Io,0000,0000,0000,,Không sao chớ?
Dialogue: 10,0:06:27.40,0:06:28.51,Default,Hime,0000,0000,0000,,K-Không sao.
Dialogue: 10,0:06:29.84,0:06:31.44,Default,Io,0000,0000,0000,,Ồ, Sakaki.
Dialogue: 10,0:06:31.44,0:06:32.83,Default,Sakaki,0000,0000,0000,,Chào!
Dialogue: 10,0:06:32.83,0:06:34.82,Default,Io,0000,0000,0000,,Sensei cô không sao chứ?
Dialogue: 10,0:06:34.82,0:06:36.37,Default,Kikue,0000,0000,0000,,Cảm ơn em cô không sao.
Dialogue: 10,0:06:36.37,0:06:38.81,Default,Tsumiki,0000,0000,0000,,Dường như đầy đủ cả rồi nhỉ
Dialogue: 10,0:06:38.81,0:06:42.21,Default,Io,0000,0000,0000,,Hiếm khi được như vậy lắm.
Dialogue: 10,0:06:42.21,0:06:44.63,Default,Mayoi,0000,0000,0000,,Cái này người ta gọi là "Tình cờ" đó phải không?
Dialogue: 10,0:06:44.63,0:06:47.51,Default,Tsumiki,0000,0000,0000,,Mỗi lần nhắc tới "Tình cờ", tớ lại muốn chém người ghê đó.
Dialogue: 10,0:06:47.51,0:06:49.63,Default,Mayoi,0000,0000,0000,,Sao lại nhìn tớ như thế?
Dialogue: 10,0:06:52.97,0:06:55.85,Default,Sakaki,0000,0000,0000,,Nãy Sensei làm tớ thật bất ngờ.
Dialogue: 10,0:06:55.85,0:06:57.14,Default,Sakaki,0000,0000,0000,,Quả là trắng sáng...
Dialogue: 10,0:06:57.44,0:06:58.79,Default,Io,0000,0000,0000,,Ý cậu là sao?
Dialogue: 10,0:06:58.79,0:07:02.12,Default,Mayoi,0000,0000,0000,,Cậu ấy đang nói tới pansu của sensei đấy.
Dialogue: 10,0:07:02.12,0:07:03.55,Default,Hime,0000,0000,0000,,P-Pansu?!
Dialogue: 10,0:07:04.29,0:07:06.09,Default,Sakaki,0000,0000,0000,,Dù sao {\i1}chúng ta{\i0} đều là con trai cả mà.
Dialogue: 10,0:07:06.09,0:07:08.05,Default,Io,0000,0000,0000,,Đừng kéo mình vào vụ này.
Dialogue: 10,0:07:08.05,0:07:09.82,Default,Hime,0000,0000,0000,,H-Hai cậu!
Dialogue: 10,0:07:09.82,0:07:12.77,Default,Hime,0000,0000,0000,,Hai cậu đúng là French!
Dialogue: 10,0:07:13.56,0:07:14.32,Default,Sakaki,0000,0000,0000,,French?
Dialogue: 10,0:07:14.32,0:07:15.83,Default,Io,0000,0000,0000,,Ý cậu là "freaks"(Đáng sợ)?
Dialogue: 10,0:07:15.83,0:07:16.93,Default,Io,0000,0000,0000,,Cả tớ luôn à?
Dialogue: 10,0:07:20.26,0:07:22.20,Default,Tsumiki,0000,0000,0000,,Cuối cùng sắp được ấm rồi.
Dialogue: 10,0:07:22.20,0:07:25.27,Default,Mayoi,0000,0000,0000,,Ừ! Thật là...
Dialogue: 10,0:07:25.27,0:07:26.15,Default,Mayoi,0000,0000,0000,,lạnh!
Dialogue: 10,0:07:26.15,0:07:27.59,Default,Those 3,0000,0000,0000,,Đóng băng mất!
Dialogue: 10,0:07:27.93,0:07:29.21,Default,Io,0000,0000,0000,,Lò sưởi hư rồi.
Dialogue: 10,0:07:29.21,0:07:31.09,Default,Tsumiki,0000,0000,0000,,Hôm qua vẫn tốt mà...
Dialogue: 10,0:07:31.09,0:07:33.61,Default,Mayoi,0000,0000,0000,,Họ chưa sửa nó xong à.
Dialogue: 10,0:07:33.61,0:07:34.71,Default,Tsumiki,0000,0000,0000,,Là sao?
Dialogue: 10,0:07:34.71,0:07:37.86,Default,Mayoi,0000,0000,0000,,Thành quả của sensei đấy.
Dialogue: 10,0:07:37.86,0:07:39.35,Default,Tsumiki,0000,0000,0000,,Thế quái nào mà...
Dialogue: 10,0:07:39.35,0:07:40.47,Default,Io,0000,0000,0000,,Đừng nói là...
Dialogue: 10,0:07:40.47,0:07:43.46,Default,Io,0000,0000,0000,,cô ấy lại vấp té?
Dialogue: 10,0:07:41.43,0:07:43.06,Alternative,,0000,0000,0000,,{\an8}Như vầy nè!
Dialogue: 10,0:07:43.46,0:07:44.85,Default,Mayoi,0000,0000,0000,,Chính xác.
Dialogue: 10,0:07:44.85,0:07:47.81,Default,Io,0000,0000,0000,,Vậy chúng ta phải chịu đựng cả ngày à...
Dialogue: 10,0:07:47.81,0:07:50.36,Default,Mayoi,0000,0000,0000,,Cứ để đó cho tớ!
Dialogue: 10,0:07:50.36,0:07:53.65,Default,Tsumiki,0000,0000,0000,,Không biết có được không đây...
Dialogue: 10,0:07:53.65,0:07:55.14,Default,Hime,0000,0000,0000,,Cậu sửa được không vậy?
Dialogue: 10,0:07:55.14,0:07:56.62,Default,Mayoi,0000,0000,0000,,Mình chỉnh sửa nó chút nhé?
Dialogue: 10,0:07:56.62,0:07:57.21,Default,Io,0000,0000,0000,,Đừng.
Dialogue: 10,0:07:57.21,0:07:58.99,Default,Hime,0000,0000,0000,,Sửa nó lại như cũ là được.
Dialogue: 10,0:07:58.99,0:08:04.17,Default,Mayoi,0000,0000,0000,,Đừng lo. Mình chỉ chỉnh nó lên 500 độ thôi.
Dialogue: 10,0:08:04.17,0:08:05.08,Default,Io,0000,0000,0000,,Xin kiếu.
Dialogue: 10,0:08:05.08,0:08:06.17,Default,Tsumiki,0000,0000,0000,,Nó ấm {\i1}quá{\i0} rồi đấy.
Dialogue: 10,0:08:11.68,0:08:18.18,Default,Kikue,0000,0000,0000,,Hôm nay cô mang cho các em một ít quà từ chuyến đi suối nước nóng.
Dialogue: 10,0:08:20.48,0:08:24.02,Default,Kikue,0000,0000,0000,,Chúng còn mới đấy nhớ ăn sớm không thì chúng bị hư đấy.
Dialogue: 10,0:08:24.02,0:08:27.65,Default,Mayoi,0000,0000,0000,,Sensei! Cô có đi chung với ai không? Chẳng hạn như bạn trai?
Dialogue: 10,0:08:31.95,0:08:33.95,Default,Kikue,0000,0000,0000,,Mỗi mình cô thôi...
Dialogue: 10,0:08:33.95,0:08:35.15,Default,Mayoi,0000,0000,0000,,Mình đạp trúng bãi mìn rồi à?
Dialogue: 10,0:08:35.15,0:08:36.03,Default,Io,0000,0000,0000,,Chắc chắn dính rồi.
Dialogue: 10,0:08:36.03,0:08:38.04,Default,Tsumiki,0000,0000,0000,,Tốt hơn là nên làm gì đi.
Dialogue: 10,0:08:38.04,0:08:39.96,Default,Mayoi,0000,0000,0000,,Ư-Ừm.
Dialogue: 10,0:08:40.45,0:08:41.70,Default,Mayoi,0000,0000,0000,,Himecchi, trông cả vào cậu đấy.
Dialogue: 10,0:08:41.70,0:08:42.74,Default,Hime,0000,0000,0000,,Hể?!{toolong to warrant the second h ?}
Dialogue: 10,0:08:42.74,0:08:44.89,Default,Tsumiki,0000,0000,0000,,Có vẻ khó khăn cho Hime đây.
Dialogue: 10,0:08:44.89,0:08:48.96,Default,Hime,0000,0000,0000,,E-Etou...., Se-Sensei...
Dialogue: 10,0:08:48.96,0:08:55.00,Default,Hime,0000,0000,0000,,Etou anou, k-kết hôn là nơi cuộc đời say xỉn!
Dialogue: 10,0:08:55.46,0:08:58.38,Default,Mayoi,0000,0000,0000,,Ý cậu ấy kết hôn là\Nnghĩa trang của cuộc sống!
Dialogue: 10,0:08:59.48,0:09:00.78,Default,Mayoi,0000,0000,0000,,Ôi trời.
Dialogue: 10,0:09:00.78,0:09:02.47,Default,Io,0000,0000,0000,,Dứt điểm rồi.
Dialogue: 10,0:09:09.07,0:09:11.23,Default,Mayoi,0000,0000,0000,,Cậu ấy đang xoay bút...
Dialogue: 10,0:09:17.24,0:09:18.80,Default,Mayoi,0000,0000,0000,,Io! Cậu thật là...
Dialogue: 10,0:09:19.30,0:09:20.43,Default,Io,0000,0000,0000,,G-Gì vậy?
Dialogue: 10,0:09:21.27,0:09:26.55,Default,Kikue,0000,0000,0000,,Io-kun! Đ-Đừng làm ồn!
Dialogue: 10,0:09:30.26,0:09:31.79,Default,Kikue,0000,0000,0000,,A-À rế...
Dialogue: 10,0:09:31.79,0:09:33.09,Default,Io,0000,0000,0000,,Cú xoáy chết người...
Dialogue: 10,0:09:36.09,0:09:40.47,Default,Mayoi,0000,0000,0000,,Cậu có biết mèo sẽ trườn người khi cậu nắm chân trước của nó hông?
Dialogue: 10,0:09:40.47,0:09:42.15,Default,Hime,0000,0000,0000,,Ừ, nó dài ra gấp đôi ha!
Dialogue: 10,0:09:42.15,0:09:43.40,Default,Mayoi,0000,0000,0000,,Không nhiều vậy đâu.
Dialogue: 10,0:09:43.40,0:09:44.60,Default,Tsumiki,0000,0000,0000,,Hai người đang nói gì vậy?
Dialogue: 10,0:09:44.84,0:09:46.35,Default,Mayoi,0000,0000,0000,,Khi cậu nắm... cẩn thận!
Dialogue: 10,0:09:50.67,0:09:52.39,Default,Tsumiki,0000,0000,0000,,Io, tránh ra.
Dialogue: 10,0:09:52.39,0:09:54.33,Default,Mayoi,0000,0000,0000,,Cậu nhận ra Io-san qua mùi của cậu ấy phả—
Dialogue: 10,0:09:56.44,0:09:58.25,Default,Io,0000,0000,0000,,Lạnh thế này mà cậu vẫn sung sức nhỉ.
Dialogue: 10,0:10:06.38,0:10:09.24,Default,Io,0000,0000,0000,,Ồ, mấy con mèo này dễ thương ghê.
Dialogue: 10,0:10:09.24,0:10:11.73,Default,Hime,0000,0000,0000,,Io-kun, cậu thích mèo à?
Dialogue: 10,0:10:11.73,0:10:17.12,Default,Io,0000,0000,0000,,Ừ. Chó và mèo trông thật hưởng thụ\Nkhi cậu nựng chúng.
Dialogue: 10,0:10:17.12,0:10:18.33,Default,Io,0000,0000,0000,,Mình thích nhìn chúng như thế.
Dialogue: 10,0:10:18.33,0:10:20.04,Default,Hime,0000,0000,0000,,Vậy Tsumiki-san thì sao?
Dialogue: 10,0:10:20.04,0:10:23.39,Default,Mayoi,0000,0000,0000,,Thỉnh thoảng cậu ấy cứ như mấy con vật bé nhỏ.
Dialogue: 10,0:10:27.79,0:10:28.64,Default,Tsumiki,0000,0000,0000,,Gì cơ?
Dialogue: 10,0:10:30.30,0:10:32.15,Default,Hime,0000,0000,0000,,Mình tiếp theo nha?
Dialogue: 10,0:10:34.15,0:10:37.47,Default,Hime,0000,0000,0000,,Tsumiki-san, cậu có thích thú nuôi ?
Dialogue: 10,0:10:38.15,0:10:41.20,Default,Hime,0000,0000,0000,,Ngoài chó,mèo,\Nthì hamster hay vài con khác thì sao ?
Dialogue: 10,0:10:41.97,0:10:43.81,Default,Tsumiki,0000,0000,0000,,K-Không hẳn.
Dialogue: 10,0:10:42.41,0:10:44.66,Alternative,Mayoi,0000,0000,0000,,Mình muốn làm thú nuôi của Io-san.
Dialogue: 10,0:10:46.62,0:10:49.29,Default,Mayoi,0000,0000,0000,,Tee-hee... Giả giọng hay không?
Dialogue: 10,0:10:49.29,0:10:51.13,Default,Io,0000,0000,0000,,Mayoi... cậu thật là...
Dialogue: 10,0:10:53.95,0:10:55.51,Default,Mayoi,0000,0000,0000,,Chúng rơi ra mất!
Dialogue: 10,0:10:55.51,0:10:57.57,Default,Sakaki,0000,0000,0000,,Này, Mayoi.
Dialogue: 10,0:10:57.57,0:10:59.86,Default,Sakaki,0000,0000,0000,,Cậu làm gì vậy...
Dialogue: 10,0:10:59.86,0:11:01.88,Default,Mayoi,0000,0000,0000,,Há lô! Sakaki-san, có gì à?
Dialogue: 10,0:11:02.52,0:11:06.14,Default,Sakaki,0000,0000,0000,,Cái micro trong phòng PA bị sao ấy, cậu có thể—
Dialogue: 10,0:11:06.14,0:11:07.55,Default,Mayoi,0000,0000,0000,,Tới ngay!
Dialogue: 10,0:11:08.68,0:11:09.55,Default,Sakaki,0000,0000,0000,,Nhanh thật...
Dialogue: 10,0:11:09.55,0:11:11.68,Default,Tsumiki,0000,0000,0000,,Mayoi có thể làm được mọi thứ à? {ok, didnt really know what "nandemo ari" meant so i stabbed at it =S}
Dialogue: 10,0:11:11.68,0:11:13.41,Default,Sakaki,0000,0000,0000,,Mặc dù cậu ấy hơi hâm hâm.
Dialogue: 10,0:11:13.41,0:11:14.80,Default,Io,0000,0000,0000,,Cậu mà cũng nói thế được sao.
Dialogue: 10,0:11:14.80,0:11:17.55,Default,Hime,0000,0000,0000,,Tưng tửng như nhau cả thôi?
Dialogue: 10,0:11:17.55,0:11:19.69,Default,Io,0000,0000,0000,,Nói thế cậu cũng vậy à.
Dialogue: 10,0:11:22.65,0:11:25.38,Default,Mayoi,0000,0000,0000,,{\pos(928,79)}Za— thử mic, thử mic.
Dialogue: 10,0:11:24.18,0:11:26.02,Default,Hime,0000,0000,0000,,Là giọng của Mayoi-san.
Dialogue: 10,0:11:27.43,0:11:29.43,Default,Mayoi,0000,0000,0000,,{\pos(926,75)}Mọi người ở trong lớp,
Dialogue: 10,0:11:29.43,0:11:32.21,Default,Mayoi,0000,0000,0000,,{\pos(844,65)}hãy chú ý nhìn qua bên phải nào.
Dialogue: 10,0:11:35.80,0:11:37.02,Default,Mayoi,0000,0000,0000,,Là bức tường đấy.
Dialogue: 10,0:11:37.02,0:11:38.38,Default,Students,0000,0000,0000,,{\i1}Giỡn mặt à?!{\i0} {a liberal would be "no shit!" but iono if thatd be acceptable.}{Hilarious, but probably not}{something tells me this line would look better if it had italics.}
Dialogue: 10,0:11:53.74,0:11:57.53,Default,Hime,0000,0000,0000,,Tsumiki-san, có muốn nếm thử của mình không?
Dialogue: 10,0:11:57.53,0:12:00.90,Default,Hime,0000,0000,0000,,Mình thử làm theo cách khác đấy!
Dialogue: 10,0:12:00.90,0:12:02.75,Default,Tsumiki,0000,0000,0000,,Cảm ơn, mình sẽ thử chút.
Dialogue: 10,0:12:03.13,0:12:05.27,Default,Mayoi,0000,0000,0000,,Mình thử luôn nha?
Dialogue: 10,0:12:05.27,0:12:06.13,Default,Hime,0000,0000,0000,,Đây nè.
Dialogue: 10,0:12:07.30,0:12:09.70,Default,Io,0000,0000,0000,,Sakaki nghĩ gì mà cứ lân lân thế ?
Dialogue: 10,0:12:09.70,0:12:11.93,Default,Sakaki,0000,0000,0000,,Nói thế nào nhỉ?
Dialogue: 10,0:12:11.93,0:12:14.41,Default,Sakaki,0000,0000,0000,,Khi ba nhỏ ở chung...
Dialogue: 10,0:12:14.41,0:12:15.39,Default,Io,0000,0000,0000,,Ồn ào phải không?
Dialogue: 10,0:12:15.81,0:12:17.78,Default,Sakaki,0000,0000,0000,,...cậu không nghĩ đến mấy "chuyện ấy" sao?
Dialogue: 10,0:12:17.78,0:12:19.06,Default,Io,0000,0000,0000,,Cậu nghĩ cái quái gì vậy?
Dialogue: 10,0:12:19.06,0:12:23.52,Default,Mayoi,0000,0000,0000,,À phải rồi, Io-san, Sakaki-san, hình như lúc nãy hai cậu bị giáo viên la hả? {Oh, right   ? too many commas though?}
Dialogue: 10,0:12:23.52,0:12:25.46,Default,Tsumiki,0000,0000,0000,,Có gì xảy ra à?
Dialogue: 10,0:12:25.46,0:12:28.38,Default,Io,0000,0000,0000,,Tụi mình đã đi tắt\Nđể đến được căn tin của trường.
Dialogue: 10,0:12:28.38,0:12:31.78,Default,Sakaki,0000,0000,0000,,Mấy cậu biết đấy lớp mình khá là xa căn tin.
Dialogue: 10,0:12:31.78,0:12:32.53,Default,,0000,0000,0000,,Hả?
Dialogue: 10,0:12:37.31,0:12:41.63,Default,,0000,0000,0000,,Teriyaki and sandwich trứng chỉ 50 yên! Chỉ một nửa giá!
Dialogue: 10,0:12:41.63,0:12:43.13,Default,,0000,0000,0000,,Đó là tại sao ta phải nhanh lên.
Dialogue: 10,0:12:44.73,0:12:47.29,Default,,0000,0000,0000,,Hai đứa! Không được chạy trên hành—
Dialogue: 10,0:12:48.69,0:12:49.97,Default,,0000,0000,0000,,Không được nhảy!
Dialogue: 10,0:12:54.19,0:12:55.50,Default,,0000,0000,0000,,Đúng là đường mới.
Dialogue: 10,0:12:56.60,0:12:59.67,Default,,0000,0000,0000,,Và rồi chúng tớ bị la.
Dialogue: 10,0:12:59.67,0:13:02.85,Default,,0000,0000,0000,,Nhưng mà tụi này đã thắng trận chiến giành sandwich.
Dialogue: 10,0:13:03.36,0:13:05.29,Default,,0000,0000,0000,,Con nít đừng làm theo nha.
Dialogue: 10,0:13:05.29,0:13:06.86,Default,,0000,0000,0000,,{\i1}Cả cậu cũng thế...{\i0}
Dialogue: 10,0:13:09.00,0:13:09.86,Default,,0000,0000,0000,,À phải rồi.
Dialogue: 10,0:13:09.86,0:13:13.21,Default,,0000,0000,0000,,Io, lát nữa ghé qua khu trò chơi không?
Dialogue: 10,0:13:13.21,0:13:15.86,Default,,0000,0000,0000,,À rế, Mayoi đâu rồi?
Dialogue: 10,0:13:15.86,0:13:17.53,Default,,0000,0000,0000,,Vừa mới thấy đây mà?
Dialogue: 10,0:13:17.53,0:13:21.00,Default,,0000,0000,0000,,Cậu ấy vừa lên phòng PA tức thì.
Dialogue: 10,0:13:21.00,0:13:22.80,Default,,0000,0000,0000,,Sửa gì nữa à?
Dialogue: 10,0:13:22.80,0:13:25.86,Default,,0000,0000,0000,,Cậu ấy muốn tổng kiểm tra lần cuối.
Dialogue: 10,0:13:25.86,0:13:27.38,Default,,0000,0000,0000,,Cẩn thận là trên hết mà.
Dialogue: 10,0:13:27.38,0:13:31.42,Default,,0000,0000,0000,,Mayoi-san giỏi cái vụ máy móc ghê. Ước gì mình được như vậy!
Dialogue: 10,0:13:31.42,0:13:34.93,Default,,0000,0000,0000,,Hime, cậu còn chẳng biết sử dụng điên thoại nữa là.
Dialogue: 10,0:13:34.93,0:13:38.86,Default,,0000,0000,0000,,Ờ. Mình chắc cậu còn chẳng biết thu lại chương trình TV nữa là.
Dialogue: 10,0:13:38.86,0:13:40.97,Default,,0000,0000,0000,,L-Làm sao cậu biết được vậy?!
Dialogue: 10,0:13:40.97,0:13:42.31,Default,,0000,0000,0000,,{\i1}Biết ngay...{\i0}
Dialogue: 10,0:13:46.43,0:13:48.02,Alternative,,0000,0000,0000,,{\an8}Thử mic, thử mic.
Dialogue: 10,0:13:46.43,0:13:48.02,Default,,0000,0000,0000,,A, Là Mayoi-san.
Dialogue: 10,0:13:48.44,0:13:49.86,Default,,0000,0000,0000,,Lần này lại gì nữa đây?
Dialogue: 10,0:13:49.86,0:13:51.78,Default,,0000,0000,0000,,Cậu ấy có cần làm vậy không ?
Dialogue: 10,0:13:59.30,0:14:00.79,Default,,0000,0000,0000,,{\i1}Vậy thôi à?!
Dialogue: 10,0:14:09.11,0:14:12.40,Default,,0000,0000,0000,,Nào đến lúc thư giãn rồi!
Dialogue: 10,0:14:12.40,0:14:15.34,Default,,0000,0000,0000,,Bộ có game mới hả?
Dialogue: 10,0:14:15.34,0:14:17.20,Default,,0000,0000,0000,,Không mình sẽ lập kỷ lục mới.
Dialogue: 10,0:14:17.20,0:14:19.84,Default,,0000,0000,0000,,Mình cũng có tiến bộ đấy!
Dialogue: 10,0:14:19.84,0:14:21.85,Default,,0000,0000,0000,,Không chờ được nữa rồi!
Dialogue: 10,0:14:21.85,0:14:22.82,Default,,0000,0000,0000,,Mình cũng vậy.
Dialogue: 10,0:14:23.55,0:14:24.55,Default,,0000,0000,0000,,{\i1}Đông thế!{\i0}
Dialogue: 10,0:14:24.55,0:14:26.61,Default,,0000,0000,0000,,Đi nào!
Dialogue: 10,0:14:31.63,0:14:37.64,Default,,0000,0000,0000,,Hình như đây là lần đầu tiên cả 5 đứa đi chơi chung thì phải?
Dialogue: 10,0:14:38.89,0:14:41.01,Default,,0000,0000,0000,,Giờ cậu mới để ý à.
Dialogue: 10,0:14:41.01,0:14:42.93,Default,,0000,0000,0000,,Nhanh lên nào!
Dialogue: 10,0:14:46.19,0:14:49.64,Default,,0000,0000,0000,,Uống gì đó trước khi chiến nào!
Dialogue: 10,0:14:49.64,0:14:51.00,Default,,0000,0000,0000,,Hay đó!
Dialogue: 10,0:14:56.29,0:14:59.95,Default,,0000,0000,0000,,Io-kun, cậu thường đến đây hông?
Dialogue: 10,0:14:59.95,0:15:02.87,Default,,0000,0000,0000,,Mình hay đến đây với Sakaki và Mayoi. {I don't think I can deinnuendo this line.}{Leave it in, it's funnier :>}
Dialogue: 10,0:15:02.87,0:15:04.66,Default,,0000,0000,0000,,Vậy à?
Dialogue: 10,0:15:04.66,0:15:07.62,Default,,0000,0000,0000,,Cũng không thường xuyên lắm.
Dialogue: 10,0:15:07.62,0:15:10.96,Default,,0000,0000,0000,,À thỉnh thoảng có đi với Tsumiki nữa.
Dialogue: 10,0:15:13.02,0:15:14.21,Default,,0000,0000,0000,,Gì đó?
Dialogue: 10,0:15:17.76,0:15:20.86,Default,,0000,0000,0000,,Được rồi! Chiến nào!
Dialogue: 10,0:15:20.86,0:15:22.55,Default,,0000,0000,0000,,Lần này tớ sẽ tiêu diệt cậu!
Dialogue: 10,0:15:22.96,0:15:25.87,Default,,0000,0000,0000,,Có Hime và mọi người đi chung nên chỉ 1 trận thôi nhé.
Dialogue: 10,0:15:28.41,0:15:30.34,Default,,0000,0000,0000,,Hửm? Gì vậy?
Dialogue: 10,0:15:43.90,0:15:46.82,Default,,0000,0000,0000,,1 lần thôi mà ra combo khũng vậy ?!
Dialogue: 10,0:15:46.82,0:15:48.15,Default,,0000,0000,0000,,Giờ thì dứt điểm rồi?!
Dialogue: 10,0:15:48.15,0:15:49.91,Default,,0000,0000,0000,,Phản xạ như là quái vật vậy!
Dialogue: 10,0:15:49.91,0:15:52.15,Default,,0000,0000,0000,,Tuyệt chiêu cuối dứt điểm rồi?!
Dialogue: 10,0:15:52.15,0:15:53.86,Default,,0000,0000,0000,,Cậu là ác ma!
Dialogue: 10,0:15:56.71,0:15:59.41,Default,,0000,0000,0000,,Io, từ khi nào mà trình của cậu?!
Dialogue: 10,0:16:01.49,0:16:03.09,Default,,0000,0000,0000,,Đừng nói là cậu nha, Miniwa?
Dialogue: 10,0:16:04.22,0:16:06.60,Default,,0000,0000,0000,,Tsumiki nói cô ấy muốn chơi nên...
Dialogue: 10,0:16:07.40,0:16:08.87,Default,,0000,0000,0000,,Hay không?
Dialogue: 10,0:16:09.31,0:16:10.47,Default,,0000,0000,0000,,Thất bại.
Dialogue: 10,0:16:17.85,0:16:20.36,Default,,0000,0000,0000,,Cứ như mơ!
Dialogue: 10,0:16:20.65,0:16:24.36,Default,,0000,0000,0000,,Nhiều thú bông dễ thương quá!
Dialogue: 10,0:16:24.84,0:16:26.81,Default,,0000,0000,0000,,Gì thế, Hime-chi?
Dialogue: 10,0:16:26.81,0:16:30.01,Default,,0000,0000,0000,,Có chắc là gắp được chúng không?
Dialogue: 10,0:16:30.98,0:16:33.37,Default,,0000,0000,0000,,Mình nghĩ cần phải có kỹ năng và luyện tập.
Dialogue: 10,0:16:33.77,0:16:35.56,Default,,0000,0000,0000,,Thật ra nó khá là đơn giản.
Dialogue: 10,0:16:35.56,0:16:36.40,Default,,0000,0000,0000,,Sao?
Dialogue: 10,0:16:36.40,0:16:38.38,Default,,0000,0000,0000,,Trông giống như chuyện cổ tích vậy!
Dialogue: 1,0:16:36.56,0:16:38.38,TS,,0000,0000,0000,,{\fad(300,0)\b1\c&HCDF6FB&\3c&H9F2BFF&\bord4\fs60\move(607,68,607,48,20,1800)\fnUVN Nguyen Du}Cổ tích
Dialogue: 0,0:16:36.56,0:16:38.38,TS,,0000,0000,0000,,{\fad(300,0)\b1\c&HCDF6FB&\3c&HED88FF&\bord8\fs60\move(607,68,607,48,20,1800)\fnUVN Nguyen Du}Cổ tích
Dialogue: 10,0:16:40.37,0:16:43.85,Default,,0000,0000,0000,,C-Cậu gắp được hết à!
Dialogue: 10,0:16:43.85,0:16:46.39,Default,,0000,0000,0000,,Công sức Io-san tập luyện đấy...
Dialogue: 10,0:16:46.39,0:16:48.80,Default,,0000,0000,0000,,Hime, cậu cũng thử đi!
Dialogue: 10,0:16:48.80,0:16:52.78,Default,,0000,0000,0000,,Dĩ nhiên mình cũng muốn thử gắp 1 con!
Dialogue: 10,0:16:52.78,0:16:53.89,Default,,0000,0000,0000,,Cố lên nhé.
Dialogue: 10,0:17:14.78,0:17:17.73,Default,,0000,0000,0000,,Nó hông chịu chạy qua nữa kìa.
Dialogue: 10,0:17:18.57,0:17:20.17,Default,,0000,0000,0000,,{\i1}Hime, cậu hài quá.{\i0}
Dialogue: 10,0:17:20.17,0:17:22.89,Default,,0000,0000,0000,,Tại sao nó không di chuyển?!
Dialogue: 10,0:17:21.67,0:17:23.13,Alternative,,0000,0000,0000,,{\i1}Cậu là động vật quý hiếm à.{\i0}
Dialogue: 10,0:17:23.13,0:17:25.17,Default,,0000,0000,0000,,Vậy ra đó là lần đầu của cậu...
Dialogue: 10,0:17:28.03,0:17:29.18,Default,,0000,0000,0000,,{\i1}Tsumiki...{\i0}
Dialogue: 10,0:17:34.20,0:17:35.76,Default,,0000,0000,0000,,Cậu thích nó không?
Dialogue: 10,0:17:36.48,0:17:38.34,Default,,0000,0000,0000,,K-Không hẳn.
Dialogue: 10,0:17:40.13,0:17:41.08,Default,,0000,0000,0000,,Nó...
Dialogue: 10,0:17:42.23,0:17:43.84,Default,,0000,0000,0000,,Muốn mình gắp nó không?
Dialogue: 10,0:17:43.84,0:17:45.07,Default,,0000,0000,0000,,Cậu thích nó đúng không?
Dialogue: 10,0:17:45.07,0:17:47.70,Default,,0000,0000,0000,,Không phải đâu.
Dialogue: 10,0:17:48.70,0:17:49.45,Default,,0000,0000,0000,,Đây rồi.
Dialogue: 10,0:17:50.17,0:17:52.55,Default,,0000,0000,0000,,May là nó dễ gắp đấy.
Dialogue: 10,0:17:52.55,0:17:54.74,Default,,0000,0000,0000,,Mình nói là không mà.
Dialogue: 10,0:17:54.74,0:17:55.38,Default,,0000,0000,0000,,Đây.
Dialogue: 10,0:18:06.54,0:18:11.65,Default,,0000,0000,0000,,K-Không phải là mình muốn nó đâu nha!
Dialogue: 10,0:18:13.30,0:18:16.55,Default,,0000,0000,0000,,Tsundere kìa! Mới vừa rồi là tsundere đó!
Dialogue: 10,0:18:16.55,0:18:17.60,Default,,0000,0000,0000,,Không sai!
Dialogue: 10,0:18:18.90,0:18:20.63,Default,,0000,0000,0000,,Đó là tsundere à? {I feel like it should be a tsundere SOMETHING. Thoughts?}
Dialogue: 10,0:18:25.28,0:18:27.28,Default,,0000,0000,0000,,Mọi người!
Dialogue: 10,0:18:27.28,0:18:30.36,Default,,0000,0000,0000,,Có ai đấu với mình không?{Maybe I'm being retarded but I don't think this makes sense}{Want to versus me?}{... i think the original line is fine.}{Want to challenge me in air hockey?} {Verse as a verb either means "to make verse" or "to familiarize by close association, study, or experience." This is neither, thus challenge seems more appropriate.}
Dialogue: 10,0:18:30.36,0:18:31.94,Default,,0000,0000,0000,,Ờ, để mình.
Dialogue: 10,0:18:31.94,0:18:35.33,Default,,0000,0000,0000,,Mình chưa thử trò đó bao giờ.
Dialogue: 10,0:18:35.33,0:18:37.79,Default,,0000,0000,0000,,Nhưng mà nó dành cho 4 người mà.
Dialogue: 10,0:18:37.79,0:18:40.90,Default,,0000,0000,0000,,Vậy thì hãy chia đội đi!
Dialogue: 10,0:18:40.90,0:18:42.76,Default,,0000,0000,0000,,Ý hay đó!
Dialogue: 10,0:18:43.35,0:18:45.78,Default,,0000,0000,0000,,Vậy thì...
Dialogue: 10,0:18:47.37,0:18:51.21,Default,,0000,0000,0000,,K-Không ai có thể chen vào giữa bọn họ!
Dialogue: 10,0:18:51.21,0:18:52.15,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 10,0:18:52.15,0:18:53.79,Default,,0000,0000,0000,,Hai cậu nói gì vậy?
Dialogue: 10,0:19:04.15,0:19:07.17,Default,,0000,0000,0000,,Io-san, Io-san. Mình hỏi cái này được không?
Dialogue: 10,0:19:07.17,0:19:07.82,Default,,0000,0000,0000,,Gì vậy?
Dialogue: 10,0:19:07.82,0:19:08.76,Default,,0000,0000,0000,,Cơ hội!
Dialogue: 10,0:19:09.24,0:19:10.09,Default,,0000,0000,0000,,Này...
Dialogue: 10,0:19:11.52,0:19:14.12,Default,,0000,0000,0000,,Trọng tài Hime, ý kiến của cậu trong tình huống vừa rồi là?
Dialogue: 10,0:19:14.12,0:19:16.15,Default,,0000,0000,0000,,T-Trọng tài ?!
Dialogue: 10,0:19:16.15,0:19:18.61,Default,,0000,0000,0000,,E-Etou, a-anou...
Dialogue: 10,0:19:19.20,0:19:20.71,Default,,0000,0000,0000,,Chiến tiếp!
Dialogue: 10,0:19:20.71,0:19:21.83,Default,,0000,0000,0000,,{\i1}Cô ấy phớt lờ nó?!{\i0}
Dialogue: 10,0:19:22.52,0:19:23.33,Default,,0000,0000,0000,,Chiến!
Dialogue: 10,0:19:38.14,0:19:40.87,Default,,0000,0000,0000,,{\i1}B-Bọn họ tính tiếp tục tới bao giờ đây?!{\i0}
Dialogue: 10,0:19:41.95,0:19:43.44,Default,,0000,0000,0000,,Á! Đánh hụt rồi rồi!
Dialogue: 10,0:19:50.16,0:19:51.95,Default,,0000,0000,0000,,Hình như lực đẩy yếu đi thì phải?
Dialogue: 10,0:19:52.46,0:19:55.70,Default,,0000,0000,0000,,Không có gió nữa. Chắc là hết giờ rồi.
Dialogue: 10,0:19:56.19,0:19:58.09,Default,,0000,0000,0000,,Có giới hạn giờ à?!
Dialogue: 10,0:19:58.09,0:19:59.80,Default,,0000,0000,0000,,Mình không biết!
Dialogue: 10,0:19:59.80,0:20:00.88,Default,,0000,0000,0000,,Mình cũng vậy.
Dialogue: 10,0:20:03.21,0:20:05.17,Default,,0000,0000,0000,,Vậy là hoà.
Dialogue: 10,0:20:05.17,0:20:08.79,Default,,0000,0000,0000,,Dù đang kịch liệt nhưng đành phân thắng bại vào hôm khác vậy.
Dialogue: 10,0:20:08.79,0:20:09.71,Default,,0000,0000,0000,,Ừ.
Dialogue: 10,0:20:09.71,0:20:13.15,Default,,0000,0000,0000,,Hết gió rồi nhưng cái miếng này thì sao đây?
Dialogue: 10,0:20:13.15,0:20:15.13,Default,,0000,0000,0000,,Có lẽ ta phải tiếp tục đến khi ai đó ghi điểm.
Dialogue: 10,0:20:17.43,0:20:20.17,Default,,0000,0000,0000,,Đợi bọn họ xong cậu muốn thử không, Hime?
Dialogue: 10,0:20:20.80,0:20:24.03,Default,,0000,0000,0000,,M-Mình không được đâu!
Dialogue: 10,0:20:24.03,0:20:28.07,Default,,0000,0000,0000,,Chỉ nhìn thôi đã thấy sợ rồi!
Dialogue: 10,0:20:30.42,0:20:32.75,Default,,0000,0000,0000,,Mình chưa thấy cậu ấy phản ứng như thế này.
Dialogue: 10,0:20:32.75,0:20:34.15,Default,,0000,0000,0000,,Đúng thế.
Dialogue: 10,0:20:40.33,0:20:41.14,Default,,0000,0000,0000,,Ô.
Dialogue: 10,0:20:41.70,0:20:46.01,Default,,0000,0000,0000,,Mình chưa thử chụp sticker lần nào cả.
Dialogue: 10,0:20:46.01,0:20:47.95,Default,,0000,0000,0000,,Mình cũng vậy.
Dialogue: 10,0:20:47.95,0:20:50.38,Default,,0000,0000,0000,,Vậy cùng chụp thử nhé?
Dialogue: 10,0:20:51.02,0:20:52.13,Default,,0000,0000,0000,,Đùa thôi.
Dialogue: 10,0:20:55.34,0:20:56.35,Default,,0000,0000,0000,,Mình muốn...
Dialogue: 10,0:20:57.75,0:21:00.26,Default,,0000,0000,0000,,Mình muốn chụp chung một bức.
Dialogue: 10,0:21:01.28,0:21:02.77,Default,,0000,0000,0000,,V-Vậy à...
Dialogue: 10,0:21:07.96,0:21:11.01,Default,,0000,0000,0000,,Tsumiki, đầu cậu bị che rồi kìa.
Dialogue: 10,0:21:12.53,0:21:14.49,Default,,0000,0000,0000,,Để mình lấy ghế.
Dialogue: 10,0:21:14.49,0:21:15.99,Default,,0000,0000,0000,,Ở đây không có đâu.
Dialogue: 10,0:21:20.52,0:21:21.87,Default,,0000,0000,0000,,Chắc hết cách rồi.
Dialogue: 10,0:21:26.00,0:21:27.09,Default,,0000,0000,0000,,Được rồi. Chụp nào.
Dialogue: 10,0:21:35.49,0:21:37.20,Default,,0000,0000,0000,,Hai cậu thật lãng mạng nha.
Dialogue: 10,0:21:39.84,0:21:41.57,Default,,0000,0000,0000,,Thật tuyệt.
Dialogue: 10,0:21:41.57,0:21:44.52,Default,,0000,0000,0000,,C-Cậu ấy đã bế nhỏ.
Dialogue: 10,0:21:45.03,0:21:46.72,Default,,0000,0000,0000,,Dù có nhìn thì cũng phải nói cho bọn tớ biết chứ.
Dialogue: 10,0:21:46.72,0:21:49.99,Default,,0000,0000,0000,,Nhưng mà hai cậu đang rất thân mật tụi mình không nỡ!
Dialogue: 10,0:21:49.99,0:21:55.28,Alternative,,0000,0000,0000,,{\an8}Bắt đầu nóng lên rồi nha! Bắt đầu nóng lên rồi nha!
Dialogue: 10,0:21:51.09,0:21:55.28,Default,,0000,0000,0000,,B-B-Bế cậu ấy!
Dialogue: 10,0:21:55.28,0:21:57.06,Default,,0000,0000,0000,,Hime, cậu không sao chứ?{More mumbo jumbo. What want?}{No and don't bother :>}{Yay}
Dialogue: 10,0:22:04.01,0:22:06.29,Default,,0000,0000,0000,,Hai cậu thôi đi được không?
Dialogue: 10,0:22:08.42,0:22:10.39,Default,,0000,0000,0000,,Nóng!
Dialogue: 10,0:23:51.45,0:23:53.64,Default Top,,0000,0000,0000,,Tuyệt quá!
Dialogue: 10,0:23:53.64,0:23:57.07,Default Top,,0000,0000,0000,,Tsumiki-chan, được leo lên đó thật tuyệt!
Dialogue: 10,0:23:57.54,0:24:00.51,Default Top,,0000,0000,0000,,Được rồi, đến đây, Hime-chan.
Dialogue: 10,0:24:01.63,0:24:03.16,Default Top,,0000,0000,0000,,Yay!
Dialogue: 10,0:24:05.13,0:24:07.45,Default Top,,0000,0000,0000,,*Nhìn chằm chằm*
Dialogue: 10,0:24:07.77,0:24:08.73,Default Top,,0000,0000,0000,,Đau.
Dialogue: 0,0:24:12.75,0:24:14.75,TS,,0000,0000,0000,,


