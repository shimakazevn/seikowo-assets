Dialogue: 0,0:00:00.40,0:00:05.40,Default,,0000,0000,0000,,
Dialogue: 0,0:00:35.74,0:00:38.01,Default,Mayo,0000,0000,0000,,Chào, mình là 1 con gấu.
Dialogue: 0,0:00:38.01,0:00:40.39,Default,Io,0000,0000,0000,,Mình có nên làm như không thấy cậu không?
Dialogue: 0,0:00:42.31,0:00:44.79,Default,Mayo,0000,0000,0000,,Mà tại sao cậu lại từ đó đi ra chứ?!
Dialogue: 0,0:00:44.79,0:00:48.30,Default,Io,0000,0000,0000,,Chỉ có thể mua loại nước này ở một vài máy cố định thôi.
Dialogue: 0,0:00:48.30,0:00:49.53,Default,Mayo,0000,0000,0000,,Sao chứ?!
Dialogue: 0,0:00:49.53,0:00:53.65,Default,Io,0000,0000,0000,,Mà sao cậu lại đi lòng vòng trong trang phục như vậy?
Dialogue: 0,0:00:53.65,0:01:01.64,Default,Mayo,0000,0000,0000,,Mình nghĩ sẽ dùng nó để dọa mọi người.
Dialogue: 0,0:01:01.64,0:01:04.47,Default,Mayo,0000,0000,0000,,Nhưng có vẻ như là thất bại rồi.
Dialogue: 0,0:01:04.47,0:01:05.15,Default,Io,0000,0000,0000,,Ừm.
Dialogue: 0,0:01:05.63,0:01:09.16,Default,Io,0000,0000,0000,,Cậu có biết là mặt cậu vẫn lộ rõ ra kìa, {re-edit this line}{*}
Dialogue: 0,0:01:09.16,0:01:11.90,Default,Io,0000,0000,0000,,vậy nên họ sẽ ngạc nhiên nhiều hơn là sợ đấy. {RE-EDIT THIS LINE}{*}
Dialogue: 0,0:01:19.87,0:01:21.12,Default,Mayo,0000,0000,0000,,Không sơ hở!
Dialogue: 0,0:01:21.12,0:01:23.21,Default,Io,0000,0000,0000,,Mình thì sợ cái tính năng đó rồi đấy. {Original: feature}
Dialogue: 10,0:03:03.35,0:03:06.10,Default,Mayo,0000,0000,0000,,Mục tiêu tiếp theo của mình là đây.
Dialogue: 10,0:03:06.10,0:03:09.70,Default,Io,0000,0000,0000,,Tsumiki hẹn gặp Mayoi ở đây hả?
Dialogue: 10,0:03:09.70,0:03:13.34,Default,Mayo,0000,0000,0000,,Nếu mình làm vậy thì sao dọa được cậu ấy chứ.
Dialogue: 10,0:03:13.34,0:03:15.03,Default,Io,0000,0000,0000,,Cậu đúng rồi đấy...
Dialogue: 10,0:03:15.03,0:03:16.53,Default,Io,0000,0000,0000,,Tsumiki nhạy bén lắm. {Original - seeing as it's Tsumiki we're talking about here}{Too long for Japanese audio}
Dialogue: 10,0:03:16.53,0:03:21.63,Default,Mayo,0000,0000,0000,,Nhưng chắc chắn đây là những gì Tsumiki đang nghĩ lúc này:
Dialogue: 10,0:03:36.36,0:03:40.76,Default,Io,0000,0000,0000,FIX,Không cần biết cậu nói đúng hay sai nhưng âm thanh kỳ lạ vào khúc cuối là sao?
Dialogue: 10,0:03:40.76,0:03:43.51,Default,Mayo,0000,0000,0000,,Được rồi bắt đầu hành động nào.
Dialogue: 0,0:03:43.51,0:03:44.39,Default,Io,0000,0000,0000,,Ờ...
Dialogue: 10,0:04:04.33,0:04:05.91,Default,Mayo,0000,0000,0000,,Lại thất bại rồi.
Dialogue: 10,0:04:05.91,0:04:07.63,Default,Io,0000,0000,0000,,Cậu nên từ bỏ đi là vừa.
Dialogue: 10,0:04:07.62,0:04:09.34,Default,Tsu,0000,0000,0000,,Chuyện gì đang diễn ra vậy?
Dialogue: 10,0:04:12.51,0:04:17.35,Default,Mayo,0000,0000,0000,,Mà này Tsumiki-san, cậu đợi Io-san đi ngang qua để hai cậu có thể cùng đến trường hả?
Dialogue: 10,0:04:17.35,0:04:18.81,Default,Tsu,0000,0000,0000,,Không có đâu.
Dialogue: 10,0:04:18.81,0:04:22.48,Default,Mayo,0000,0000,0000,,Nhưng mà Io-san hay đến trường cùng cậu lắm mà.
Dialogue: 10,0:04:23.67,0:04:28.32,Default,Io,0000,0000,0000,,Đó là tại vì tụi mình hay gặp nhau trên đường thôi.
Dialogue: 10,0:04:28.32,0:04:30.79,Default,Io,0000,0000,0000,,Không phải là tụi mình hẹn gặp tại chỗ nào đó hay gì đâu.
Dialogue: 10,0:04:31.86,0:04:33.86,Default,Mayo,0000,0000,0000,,Mình hiểu cậu mà Tsukimi-san,
Dialogue: 10,0:04:34.70,0:04:37.45,Default,Mayo,0000,0000,0000,,cậu chắc chắn sẽ thay đổi thời gian và địa điểm chạm mặt mỗi ngày,
Dialogue: 10,0:04:37.45,0:04:42.62,Default,Mayo,0000,0000,0000,,để làm nó thật sự trông như là trùng hợp vậy.
Dialogue: 10,0:04:42.62,0:04:44.10,Default,Mayo,0000,0000,0000,,Đúng hông?
Dialogue: 10,0:04:46.61,0:04:47.63,Default,Mayo,0000,0000,0000,,Đúng thật à?!{Original - You actually do that?!}{Audio matching}
Dialogue: 10,0:04:52.49,0:04:54.49,Default,Io,0000,0000,0000,,Mà này Hime đâu rồi?
Dialogue: 10,0:04:54.49,0:04:56.55,Default,Io,0000,0000,0000,,Cậu ấy thường đến trường chung với tụi mình mà.
Dialogue: 10,0:04:56.55,0:04:59.86,Default,Mayo,0000,0000,0000,,Mình đã nói nhỏ đi trước để có cơ hội dọa nhỏ.
Dialogue: 10,0:04:59.86,0:05:04.02,Default,Mayo,0000,0000,0000,,Mình sẽ dọa Hime bù cho phần của cả 2 cậu!
Dialogue: 10,0:05:04.02,0:05:05.90,Default,Io,0000,0000,0000,,Hime rất dễ bị dọa cho phát sợ lên ha?
Dialogue: 10,0:05:05.90,0:05:07.45,Default,Tsu,0000,0000,0000,,Đúng vậy. Cậu ấy sẽ bị dọa thôi.
Dialogue: 10,0:05:08.97,0:05:11.44,Default,Mayo,0000,0000,0000,,Mình sẽ dọa cậu ấy sợ sút quần luôn!
Dialogue: 10,0:05:11.44,0:05:12.76,Default,Io,0000,0000,0000,,Đừng có làm quá nha?
Dialogue: 10,0:05:12.76,0:05:15.18,Default,Io,0000,0000,0000,,Nếu mà cậu làm vậy chắc chắn...
Dialogue: 10,0:05:15.54,0:05:17.07,Default,Io,0000,0000,0000,,sẽ dọa cậu ấy sứt cổ ra mất.
Dialogue: 10,0:05:17.07,0:05:19.68,Default,Hime,0000,0000,0000,,Mình sợ run lên mất không đi nổi nữa! {okay yeah this is shit we need something better}
Dialogue: 10,0:05:18.79,0:05:19.68,Alternative,Mayo,0000,0000,0000,,Cổ nhỏ?! {Try to resist substituting "ass" for "neck" kthxkudasai. Try.}
Dialogue: 10,0:05:25.01,0:05:26.69,Default,Hime,0000,0000,0000,,Mayoi-san!
Dialogue: 10,0:05:26.69,0:05:28.07,Default,Hime,0000,0000,0000,,Chào buổi sáng
Dialogue: 10,0:05:40.18,0:05:43.30,Default,Hime,0000,0000,0000,,Một con gấu đang đuổi theo mình bằng hai chân!
Dialogue: 10,0:05:46.93,0:05:48.71,Default,Io,0000,0000,0000,,Hai chân...
Dialogue: 10,0:05:50.72,0:05:53.47,Default,Mayo,0000,0000,0000,,Đây mới là phản ứng mà mình nhắm đến!
Dialogue: 10,0:05:54.82,0:05:56.75,Default,Tsu,0000,0000,0000,,Không sao chứ, Hime?
Dialogue: 10,0:05:57.81,0:06:00.55,Default,Hime,0000,0000,0000,,Mình sợ gần chết!
Dialogue: 10,0:06:00.55,0:06:02.48,Default,Tsu,0000,0000,0000,,Cậu chạy cứ như ma đuổi theo sau  cậu vậy áh
Dialogue: 10,0:06:02.48,0:06:07.24,Default,Mayo,0000,0000,0000,,Nhưng mình không nghĩ cậu lại sợ đến vậy.
Dialogue: 10,0:06:07.24,0:06:08.84,Default,Mayo,0000,0000,0000,,Không sao đó chứ?
Dialogue: 10,0:06:08.84,0:06:10.36,Default,Io,0000,0000,0000,,Đây dùng khăn của mình đi này.
Dialogue: 10,0:06:10.36,0:06:12.53,Default,Hime,0000,0000,0000,,Cảm ơn cậu nha!
Dialogue: 10,0:06:12.93,0:06:17.51,Default,Io,0000,0000,0000,,Mà mình nghĩ nếu một con gấu đuổi theo cậu như một vận động viên chuyên nghiệp,
Dialogue: 10,0:06:17.51,0:06:19.47,Default,Io,0000,0000,0000,,cậu chắc phải sợ hãi thôi.
Dialogue: 10,0:06:20.17,0:06:22.96,Default,Tsu,0000,0000,0000,,Nó thật sự như mấy thứ trong phim kinh dị ấy cậu cảm thấy vậy chứ.
Dialogue: 10,0:06:22.96,0:06:25.25,Default,Hime,0000,0000,0000,,Thật là kinh hoàng!
Dialogue: 10,0:06:27.77,0:06:29.75,Default,Hime,0000,0000,0000,,A, Sakaki-san kìa!
Dialogue: 10,0:06:29.75,0:06:31.88,Default,Io,0000,0000,0000,,Cậu tính dọa Sakaki luôn à?
Dialogue: 10,0:06:31.88,0:06:33.91,Default,Mayo,0000,0000,0000,,Dĩ nhiên dĩ nhiên!
Dialogue: 10,0:06:33.91,0:06:34.88,Default,Mayo,0000,0000,0000,,Đi nào
Dialogue: 10,0:06:36.51,0:06:37.62,Default,Tsu,0000,0000,0000,,Sao vậy?
Dialogue: 10,0:06:37.62,0:06:42.35,Default,Mayo,0000,0000,0000,,Cậu có nghĩ tấn công trực diện cậu ấy thì sẽ đáng sợ hơn không?
Dialogue: 10,0:06:42.35,0:06:46.87,Default,Io,0000,0000,0000,,Mình nghỉ nếu làm quá lên cậu ấy sẽ nhận ra ngay.
Dialogue: 10,0:06:46.87,0:06:52.46,Default,Mayo,0000,0000,0000,,Chạy bằng 2 chân hay 4 chân... mình không biết cái nào thì tốt hơn.
Dialogue: 10,0:06:52.46,0:06:56.96,Default,Io,0000,0000,0000,,Mình nghĩ tốt nhất là cậu dọa từ đây nhanh đi để cậu ấy không kịp phản ứng.
Dialogue: 10,0:06:56.96,0:06:58.92,Default,Tsu,0000,0000,0000,,Một con gấu cưỡi ván trượt tuyết...
Dialogue: 10,0:06:58.92,0:06:59.58,Default,Everyone,0000,0000,0000,,Hử?
Dialogue: 10,0:06:59.58,0:07:03.58,Default,Tsu,0000,0000,0000,,lao thẳng tới với tốc độ cao. Nghe được không?
Dialogue: 10,0:07:03.58,0:07:05.58,Default,Hime,0000,0000,0000,,Tụi mình không có ý giết cậu ấy đâu đó!
Dialogue: 10,0:07:08.71,0:07:11.21,Default,Mayo,0000,0000,0000,,Vậy thì làm đi nào!
Dialogue: 10,0:07:15.30,0:07:16.88,Default,Mayo,0000,0000,0000,,Ready...
Dialogue: 10,0:07:28.22,0:07:29.94,Default,Saka,0000,0000,0000,,Cái quái gì vậy?!
Dialogue: 10,0:07:30.35,0:07:31.69,Default,Saka,0000,0000,0000,,Uwewewe! {TLC}
Dialogue: 10,0:07:45.46,0:07:47.83,Default,Io,0000,0000,0000,,Hai cậu không sao chứ?
Dialogue: 10,0:07:47.83,0:07:49.84,Default,Saka,0000,0000,0000,,L-Là cậu đấy à, Io?
Dialogue: 10,0:07:50.92,0:07:54.34,Default,Saka,0000,0000,0000,,Giải thích cho mình cái gì vừa xảy ra.
Dialogue: 10,0:07:54.34,0:07:59.02,Default,Saka,0000,0000,0000,,Ngay khi mình trông thấy một con gấu lao vào mình nhanh như chớp trên tấm ván trượt thì,
Dialogue: 10,0:07:59.02,0:08:01.33,Default,Saka,0000,0000,0000,,Mình bị húc mạnh bằng đầu?!
Dialogue: 10,0:08:01.33,0:08:04.35,Default,Saka,0000,0000,0000,,Mình thật sự không hiểu cái gì đang xảy ra nữa.
Dialogue: 10,0:08:04.35,0:08:06.26,Default,Tsu,0000,0000,0000,,Đầu cậu không sao chứ?
Dialogue: 10,0:08:06.26,0:08:08.26,Default,Saka,0000,0000,0000,,M-Mình không chắc nữa.
Dialogue: 10,0:08:08.26,0:08:10.61,Default,Io,0000,0000,0000,,Không cô ấy không hỏi cậu...
Dialogue: 10,0:08:15.11,0:08:20.82,Default,Mayo,0000,0000,0000,,S-Sau khi xem xét lại hết dường như mình đã dọa được Sakaki-san.
Dialogue: 10,0:08:20.82,0:08:23.61,Default,Saka,0000,0000,0000,,Mình ghét phải thừa nhận nhưng đúng là một đòn tấn công bất ngờ.
Dialogue: 10,0:08:23.61,0:08:24.87,Default,Io,0000,0000,0000,,Cậu bị húc bay đi đó thôi.
Dialogue: 10,0:08:24.87,0:08:29.88,Default,Saka,0000,0000,0000,,Mình không nghĩ còn ai khác ngoài Miiko-nee và Miniwa không sợ khi bị dọa như vậy.
Dialogue: 10,0:08:29.88,0:08:30.63,Default,Io,0000,0000,0000,,Không...
Dialogue: 10,0:08:31.54,0:08:34.63,Default,Io,0000,0000,0000,,Mình nghĩ nếu như vậy cả Miiko-san cũng bị dọa và...
Dialogue: 10,0:08:36.12,0:08:37.26,Default,Miiko,0000,0000,0000,,A rà á ra.
Dialogue: 10,0:08:38.70,0:08:41.73,Default,Io,0000,0000,0000,,À rế...? Mình không thể hình dung ra được.
Dialogue: 10,0:08:41.73,0:08:44.26,Default,Hime,0000,0000,0000,,Đây không phải là tình huống có thể cười được! {would or should?}
Dialogue: 10,0:08:44.26,0:08:48.25,Default,Io,0000,0000,0000,,Ý mình muốn nói là dọa cho Miiko-san sợ là bất khả thi.
Dialogue: 10,0:08:48.25,0:08:49.09,Default,Saka,0000,0000,0000,,Biết mà.
Dialogue: 10,0:08:50.02,0:08:52.85,Default,Mayo,0000,0000,0000,,Mình đang nhắm vào Kikue-sensei phía trước! {is the a intentional?}
Dialogue: 10,0:08:53.82,0:08:58.03,Default,Mayo,0000,0000,0000,,Hãy bắt đầu nhiệm vụ đặc biệt nào!
Dialogue: 10,0:08:59.04,0:09:01.56,Default,Saka,0000,0000,0000,,Được lắm! Mình sẽ tham gia!
Dialogue: 10,0:09:01.56,0:09:03.12,Default,Tsu,0000,0000,0000,,Mình đoán là không có cách nào cản được hai cậu.
Dialogue: 10,0:09:03.12,0:09:04.57,Default,Saka,0000,0000,0000,,Không thể nào đâu!
Dialogue: 10,0:09:04.57,0:09:07.41,Default,Io,0000,0000,0000,,Nếu cậu đuổi theo cô với Mayoi,
Dialogue: 10,0:09:07.41,0:09:10.40,Default,Io,0000,0000,0000,,vậy chắc chắn cô sẽ biết hai người đang đùa rồi.
Dialogue: 10,0:09:10.40,0:09:12.29,Default,Saka,0000,0000,0000,,Hừm, đúng vậy ha.
Dialogue: 10,0:09:12.29,0:09:16.09,Default,Saka,0000,0000,0000,,Đó là tại sao mình đã chuẩn bị vài thứ.
Dialogue: 10,0:09:18.69,0:09:20.05,Default,Saka,0000,0000,0000,,Thế này được chứ.
Dialogue: 10,0:09:20.05,0:09:21.28,Default,Mayo,0000,0000,0000,,Gì vậy! {Original: What's that?!}
Dialogue: 10,0:09:21.28,0:09:24.30,Default,Io,0000,0000,0000,,Nếu mình mà là cảnh sát mình sẽ hốt cậu về đồn.
Dialogue: 10,0:09:26.31,0:09:28.18,Default,Mayo & Saka,0000,0000,0000,,Vậy tụi này đi nhé!
Dialogue: 10,0:09:28.18,0:09:30.11,Default,Io,0000,0000,0000,,Hai cậu trông thật quái đản.
Dialogue: 10,0:09:32.54,0:09:34.48,Default,Boy,0000,0000,0000,,Sensei! Chào buổi sáng!
Dialogue: 10,0:09:34.48,0:09:36.20,Default,Kikue,0000,0000,0000,,Chào buổi sáng!
Dialogue: 10,0:09:36.20,0:09:38.63,Default,Mayo,0000,0000,0000,,Sensei, chào buổi sáng!
Dialogue: 10,0:09:38.63,0:09:39.86,Default,Kikue,0000,0000,0000,,Ừ, chào buổi sáng!
Dialogue: 10,0:09:46.69,0:09:48.53,Default,Saka,0000,0000,0000,,Chào buổi sáng.
Dialogue: 10,0:09:49.87,0:09:52.50,Default,Kikue,0000,0000,0000,,Ế? Hả?
Dialogue: 10,0:09:52.92,0:09:55.38,Default,Mayo & Saka,0000,0000,0000,,Đi nào!
Dialogue: 10,0:10:01.24,0:10:03.46,Default,Hime,0000,0000,0000,,Họ còn tính làm gì nữa vậy?!
Dialogue: 10,0:10:03.46,0:10:05.44,Default,Io,0000,0000,0000,,Tới trường... chắc vậy.
Dialogue: 10,0:10:05.44,0:10:07.59,Default,Hime,0000,0000,0000,,Đợi đã!
Dialogue: 10,0:10:09.10,0:10:10.28,Default,Io,0000,0000,0000,,Mình cũng đi thôi.
Dialogue: 10,0:10:12.68,0:10:13.52,Default,Io,0000,0000,0000,,À.
Dialogue: 10,0:10:13.52,0:10:14.77,Default,Tsu,0000,0000,0000,,Ơ?
Dialogue: 10,0:10:14.77,0:10:17.52,Default,Io,0000,0000,0000,,Tsumiki, về chuyện sáng nay...
Dialogue: 10,0:10:18.67,0:10:22.94,Default,Tsu,0000,0000,0000,,Mình không cố tình đợi cậu hay gì đó đâu...
Dialogue: 10,0:10:22.94,0:10:24.68,Default,Io,0000,0000,0000,,Hay là tụi mình cùng đi đến trường đi?
Dialogue: 10,0:10:26.27,0:10:27.49,Default,Io,0000,0000,0000,,Kể từ ngày mai nhé.
Dialogue: 10,0:10:27.49,0:10:33.76,Default,Tsu,0000,0000,0000,,Etou, anou, được ,nhưng mà tại sao...?
Dialogue: 10,0:10:33.76,0:10:35.25,Default,Io,0000,0000,0000,,Ồ...
Dialogue: 10,0:10:35.24,0:10:39.36,Default,Io,0000,0000,0000,,Vì buổi sáng ngày càng lạnh mà ha.
Dialogue: 10,0:10:39.36,0:10:42.26,Default,Tsu,0000,0000,0000,,Mình đã nói không phải vậy rồi mà...
Dialogue: 10,0:10:42.78,0:10:44.09,Default,Tsun,0000,0000,0000,,Mồ.
Dialogue: 10,0:10:51.08,0:10:54.25,Default,Kikue,0000,0000,0000,,Dừng lại đi mà!
Dialogue: 10,0:11:06.20,0:11:08.48,Default,Io,0000,0000,0000,,Sắp tới lúc nghỉ đông rồi.
Dialogue: 10,0:11:08.48,0:11:09.63,Default,Hime,0000,0000,0000,,Đúng rồi ha.
Dialogue: 10,0:11:09.63,0:11:12.77,Default,Mayo,0000,0000,0000,,{\an8}Mọi người! Ngày 24 này nhất định phải rảnh nha!
Dialogue: 10,0:11:12.77,0:11:15.56,Default,Io,0000,0000,0000,,{\an8}Mình và Hime đã có kế hoạch cho ngày đó rồi.
Dialogue: 10,0:11:15.56,0:11:16.62,Default,Mayo,0000,0000,0000,,{\an8}Cậu vừa nói gì cơ?!
Dialogue: 10,0:11:16.62,0:11:18.50,Default,Mayo,0000,0000,0000,,{\an8}Hai người đã hẹn với nhau trước rồi à?!
Dialogue: 10,0:11:23.44,0:11:24.88,Default,Mayo,0000,0000,0000,,{\an8}Tsumiki-san!
Dialogue: 10,0:11:24.88,0:11:26.16,Default,Io,0000,0000,0000,,{\an8}Sao vậy Tsumiki?
Dialogue: 10,0:11:26.16,0:11:27.79,Default,Io,0000,0000,0000,,{\an8}Sao cậu trông chán nản thế.
Dialogue: 10,0:11:27.79,0:11:29.72,Default,Tsu,0000,0000,0000,,{\an8}Không công bằng!
Dialogue: 10,0:11:29.72,0:11:32.39,Default,Mayo,0000,0000,0000,,Io-san cậu không hiểu cái gì hết phải không?
Dialogue: 10,0:11:33.45,0:11:35.26,Default,Tsu,0000,0000,0000,,Vậy cậu muốn nói là cậu phải làm việc vào hôm đó à?
Dialogue: 10,0:11:35.26,0:11:39.39,Default,Io,0000,0000,0000,,Ừ. Hime, Sakaki, và mình phải làm việc vào hôm đó. {Does this match up with the audio? We'll find out!}
Dialogue: 10,0:11:39.39,0:11:40.53,Default,Hime,0000,0000,0000,,Ừ!
Dialogue: 10,0:11:42.78,0:11:45.49,Default,Mayo,0000,0000,0000,,Mà khoan tại sao các cậu phải làm việc vào ngày hôm đó? {????}
Dialogue: 10,0:11:45.49,0:11:47.96,Default,Io,0000,0000,0000,,Mình không có kế hoạch gì khác vào ngày đó.
Dialogue: 10,0:11:47.96,0:11:49.29,Default,Hime,0000,0000,0000,,Mình cũng vậy.
Dialogue: 10,0:11:49.29,0:11:50.97,Default,Mayo,0000,0000,0000,,No!
Dialogue: 10,0:11:50.97,0:11:53.56,Default,Mayo,0000,0000,0000,,Ngay cả khi đó là Giáng sinh...
Dialogue: 10,0:11:53.56,0:11:54.79,Default,Io,0000,0000,0000,,Đúng là vậy đấy.
Dialogue: 10,0:11:55.91,0:11:59.85,Default,Mayo,0000,0000,0000,,Mấy cậu không có gì hay hơn để làm sao?
Dialogue: 10,0:12:00.51,0:12:01.95,Default,Io,0000,0000,0000,,Như là gì?
Dialogue: 10,0:12:01.95,0:12:04.46,Default,Mayo,0000,0000,0000,,Hừm, như là...
Dialogue: 10,0:12:04.46,0:12:08.19,Default,Mayo,0000,0000,0000,,ở bên cạnh người mình yêu từ lúc thức dậy tới khi đi ngủ.
Dialogue: 10,0:12:08.19,0:12:09.47,Default,Hime,0000,0000,0000,,Cùng người mình yêu?
Dialogue: 10,0:12:09.47,0:12:11.60,Default,Mayo,0000,0000,0000,,Và suy nghĩ về cuộc sống.
Dialogue: 10,0:12:11.60,0:12:14.47,Default,Io,0000,0000,0000,,Chính xác thì cặp đó làm gì vào Giáng sinh vậy?
Dialogue: 10,0:12:16.48,0:12:19.48,Default,Io,0000,0000,0000,,Mà hôm đó cậu có kế hoạch gì không?
Dialogue: 10,0:12:20.45,0:12:24.48,Default,Mayo,0000,0000,0000,,Mình sẽ tổ chức tiệc Giáng sinh cùng với mọi người...
Dialogue: 10,0:12:29.43,0:12:30.88,Default,Mayo,0000,0000,0000,,Nhưng giấc mơ chỉ là giấc mơ.
Dialogue: 10,0:12:30.88,0:12:33.49,Default,Hime,0000,0000,0000,,Mayoi-san trông thật tuyệt vọng!
Dialogue: 10,0:12:33.49,0:12:34.91,Default,Io,0000,0000,0000,,V-Vậy sao...?
Dialogue: 10,0:12:34.91,0:12:36.31,Default,Mayo,0000,0000,0000,,Nhưng mà không sao đâu.
Dialogue: 10,0:12:36.31,0:12:38.89,Default,Mayo,0000,0000,0000,,Nếu các cậu đã có kế hoạch rồi thì thôi vậy.{herrpderp "can't be herped"}
Dialogue: 10,0:12:38.89,0:12:41.00,Default,Tsu,0000,0000,0000,,Cậu ấy nói chuyện cũng khác thường nữa.
Dialogue: 10,0:12:41.00,0:12:45.83,Default,Mayo,0000,0000,0000,,Cũng có nghĩa là Io và Hime sẽ trải qua ngày Giáng sinh cùng với nhau phải không ha?
Dialogue: 10,0:12:46.47,0:12:48.01,Default,Hime,0000,0000,0000,,Chỉ là công việc thôi!
Dialogue: 10,0:12:52.94,0:12:55.04,Default,Hime,0000,0000,0000,,Tsumiki-san cũng vào đó luôn sao?
Dialogue: 10,0:12:55.04,0:12:58.89,Default,Io,0000,0000,0000,,Vậy các cậu có muốn làm chung với tụi mình không ?
Dialogue: 10,0:13:00.14,0:13:03.35,Default,Io,0000,0000,0000,,Miiko-san nói chị ấy đang cần thêm người giúp vào ngày hôm đó.
Dialogue: 10,0:13:07.44,0:13:08.77,Default,Mayo,0000,0000,0000,,Thật chứ? {orginal: Are you kidding?}
Dialogue: 10,0:13:10.15,0:13:11.41,Default,Io,0000,0000,0000,,Ờ. {original: I'm not}
Dialogue: 10,0:13:11.53,0:13:13.36,Default,Mayo,0000,0000,0000,,Đồng ý!
Dialogue: 10,0:13:13.36,0:13:14.66,Default,Tsu,0000,0000,0000,,Mình sẽ giúp mọi người.
Dialogue: 10,0:13:14.66,0:13:17.04,Default,Hime,0000,0000,0000,,Mọi người sẽ làm chung vào Giáng sinh ha!
Dialogue: 10,0:13:31.67,0:13:33.20,Default,Mayo,0000,0000,0000,,Chào!
Dialogue: 10,0:13:33.20,0:13:34.69,Default,Saka,0000,0000,0000,,Ồ, đến rồi à.
Dialogue: 10,0:13:34.69,0:13:35.63,Default,Tsu,0000,0000,0000,,Chào buổi sáng.
Dialogue: 10,0:13:35.63,0:13:36.61,Default,Io,0000,0000,0000,,Chào buổi sáng.
Dialogue: 10,0:13:36.61,0:13:38.51,Default,Hime,0000,0000,0000,,Chào buổi sáng!
Dialogue: 10,0:13:38.52,0:13:40.55,Default,Mayo,0000,0000,0000,,Mình đợi ngày này lâu rồi đó!
Dialogue: 10,0:13:40.55,0:13:41.76,Default,Hime,0000,0000,0000,,Ừ!
Dialogue: 10,0:13:41.76,0:13:44.51,Default,Miiko,0000,0000,0000,,Cảm ơn đã đến giúp chị nha.
Dialogue: 10,0:13:44.51,0:13:45.71,Default,Mayo,0000,0000,0000,,Vâng!
Dialogue: 10,0:13:45.71,0:13:47.78,Default,Tsu,0000,0000,0000,,Hãy chỉ bảo thêm cho em.
Dialogue: 10,0:13:47.78,0:13:54.24,Default,Miiko,0000,0000,0000,,Vậy thì hôm nay chị muốn tụi em cùng bán bánh Giáng sinh với Io ở sạp hàng trước tiệm...
Dialogue: 10,0:13:54.24,0:13:55.57,Default,Mayo,0000,0000,0000,,Rõ rồi ạ!
Dialogue: 10,0:13:55.57,0:13:57.51,Default,Miiko,0000,0000,0000,,...và nhớ mặc trang phục Santa.
Dialogue: 10,0:13:57.51,0:13:58.56,Default,Mayo,0000,0000,0000,,Santa?!
Dialogue: 10,0:13:58.56,0:14:01.53,Default,Io,0000,0000,0000,,Miiko-san, vậy em cũng phải mặc luôn à?
Dialogue: 10,0:14:01.53,0:14:03.42,Default,Miiko,0000,0000,0000,,Hãy làm vậy nhé.{Alt - Pretty please?}
Dialogue: 10,0:14:03.42,0:14:04.75,Default,Io,0000,0000,0000,,V-Vâng...{Okay.jpg}
Dialogue: 10,0:14:04.75,0:14:06.73,Default,Miiko,0000,0000,0000,,Chị chắc em sẽ nhìn thật tuyệt mà.
Dialogue: 10,0:14:07.54,0:14:09.94,Default,Mayo,0000,0000,0000,,Io-san bị áp chế rồi!
Dialogue: 10,0:14:09.94,0:14:14.79,Default,Saka,0000,0000,0000,,Miiko-nee nắm được lợi thế từ một trong vài điểm yếu của cậu ấy.
Dialogue: 10,0:14:18.80,0:14:22.28,Default,Mayo,0000,0000,0000,,Bộ đồ Santa ấm thật ha.
Dialogue: 10,0:14:22.28,0:14:23.84,Default,Mayo,0000,0000,0000,,Ấm áp và mềm mại!
Dialogue: 10,0:14:23.84,0:14:27.49,Default,Miiko,0000,0000,0000,,Thật đang tiếc là chỉ được mặc nó vào thời điểm nay trong năm thôi ha.
Dialogue: 10,0:14:27.49,0:14:28.81,Default,Hime,0000,0000,0000,,Tsumiki-san thì sao rồi?
Dialogue: 10,0:14:31.56,0:14:34.30,Default,Miiko,0000,0000,0000,,Đây là bộ nhỏ nhất mà chị có đấy.
Dialogue: 10,0:14:34.30,0:14:37.53,Default,Hime,0000,0000,0000,,Cậu nhìn dễ thương lắm Tsumiki-san!
Dialogue: 10,0:14:38.32,0:14:40.57,Default,Io,0000,0000,0000,,Mình nghĩ nó hợp với cậu lắm...
Dialogue: 10,0:14:40.57,0:14:42.10,Default,Mayo/Saka,0000,0000,0000,,...cậu ấy nói rồi đấy.
Dialogue: 10,0:14:43.07,0:14:45.86,Default,Hime,0000,0000,0000,,Trông vừa vặn với cậu lắm đấy Io-kun!
Dialogue: 10,0:14:45.86,0:14:47.08,Default,Mayo,0000,0000,0000,,Đúng nha!
Dialogue: 10,0:14:47.08,0:14:49.08,Default,Io,0000,0000,0000,,Không phải đâu.
Dialogue: 10,0:14:49.08,0:14:52.08,Default,Saka,0000,0000,0000,,Cậu là Santa sẽ làm cho mọi cô gái đổ ngay từ ánh mắt đầu tiên.{I'm pretty sure he's referring to females only, thus everyone -> all girls}
Dialogue: 10,0:14:53.33,0:14:57.71,Default,Mayo,0000,0000,0000,,Vậy món quà thú vị mà Santa Io-san định tặng là gì? {TLC}
Dialogue: 10,0:14:57.71,0:15:01.17,Default,Saka,0000,0000,0000,,Chắc chắn là thứ khiến tim các bé đập mạnh rồi. {Do we want more innuendo here? Just let me know~}
Dialogue: 10,0:15:01.17,0:15:05.84,Default,Io,0000,0000,0000,,Nếu cậu ngoan, mình sẽ cho cậu tất cả những gì cậu muốn.
Dialogue: 10,0:15:05.84,0:15:06.81,Default,Io,0000,0000,0000,,Gần giống vậy đấy?
Dialogue: 10,0:15:09.60,0:15:11.30,Default,Mayo/Saka,0000,0000,0000,,Gục rồi sao?!
Dialogue: 10,0:15:11.30,0:15:12.18,Default,Miiko,0000,0000,0000,,A rà á ra.
Dialogue: 10,0:15:23.58,0:15:25.32,Default,Hime,0000,0000,0000,,Chuẩn bị ra sao rồi?
Dialogue: 10,0:15:25.32,0:15:27.13,Default,Mayo,0000,0000,0000,,Gần xong hết rồi.
Dialogue: 10,0:15:27.13,0:15:28.49,Default,Io,0000,0000,0000,,Tsumiki, Mayoi.
Dialogue: 10,0:15:29.49,0:15:31.05,Default,Mayo,0000,0000,0000,,Chuyện gì vậy?
Dialogue: 10,0:15:33.78,0:15:34.83,Default,Io,0000,0000,0000,,Đây, cầm lấy.
Dialogue: 10,0:15:36.03,0:15:37.58,Default,Mayo,0000,0000,0000,,Đồ làm ấm tay?
Dialogue: 10,0:15:37.58,0:15:41.25,Default,Io,0000,0000,0000,,Các cậu sẽ đứng cả ngày ngoài trời vì vậy hãy sử dụng chúng đi nhé.
Dialogue: 10,0:15:41.96,0:15:44.89,Default,Mayo,0000,0000,0000,,Ôi sự tốt bụng thật tuyệt vời và ấm áp.
Dialogue: 10,0:15:44.89,0:15:46.29,Default,Tsu,0000,0000,0000,,Ấm áp quá.
Dialogue: 10,0:15:47.63,0:15:50.35,Default,Saka,0000,0000,0000,,Các cậu, đừng để bị lạnh bên
Dialogue: 10,0:15:50.35,0:15:53.53,Default,Saka,0000,0000,0000,,Mà Miniwa thật sự có vẻ ấm lắm rồi.
Dialogue: 10,0:15:53.53,0:15:56.89,Default,Mayo,0000,0000,0000,,Io-san đã cho nhỏ một cơn say nắng.
Dialogue: 10,0:15:57.96,0:16:00.61,Default,Saka,0000,0000,0000,,Vậy à... say nắng...
Dialogue: 10,0:16:00.73,0:16:04.36,Default,Saka,0000,0000,0000,,Mayoi! Nói cho tụi mình biết ý nghĩa khác của say nắng nào!
Dialogue: 10,0:16:06.84,0:16:12.62,Default,Mayo,0000,0000,0000,,Nói cách khác, Tsumiki muốn nói với Io, "Hãy hôn mình đi nha."
Dialogue: 10,0:16:13.95,0:16:16.40,Default,Hime,0000,0000,0000,,Cậu ấy sẽ hôn cậu kìa!
Dialogue: 10,0:16:16.40,0:16:17.62,Default,Io,0000,0000,0000,,Hôn...
Dialogue: 10,0:16:21.63,0:16:25.51,Default,Io,0000,0000,0000,,Xong, chồng 3 hộp lên nhau có lẽ được rồi đấy.
Dialogue: 10,0:16:25.51,0:16:26.63,Default,Hime,0000,0000,0000,,Đúng vậy đó.
Dialogue: 10,0:16:26.63,0:16:28.68,Default,Tsu,0000,0000,0000,,Ba hộp hử?
Dialogue: 10,0:16:28.68,0:16:29.61,Default,Io,0000,0000,0000,,Ừ.
Dialogue: 10,0:16:29.61,0:16:31.88,Default,Io,0000,0000,0000,,Và sau khi bán được tụi mình phải chồng thêm lên.
Dialogue: 10,0:16:31.88,0:16:33.02,Default,Tsu,0000,0000,0000,,Biết rồi.
Dialogue: 10,0:16:33.02,0:16:35.65,Default,Io,0000,0000,0000,,Khi chồng lên thế này trông chúng thật lớn.
Dialogue: 10,0:16:35.65,0:16:39.51,Default,Hime,0000,0000,0000,,Anou, Tsumiki-san, mình chỉ thấy mỗi nón của cậu thôi.
Dialogue: 10,0:16:39.51,0:16:40.48,Default,Io,0000,0000,0000,FIX,Sao chứ! {CHANGE PLEASE}{There are plenty of alternative ways to express Sốc. i.e. "What the...?", "The hell...?", "What?", "Oh my!", Whoa!", etc.}
Dialogue: 10,0:16:40.48,0:16:41.77,Default,Tsu,0000,0000,0000,,Gì nữa đây?
Dialogue: 10,0:16:43.04,0:16:45.70,Default,Miiko,0000,0000,0000,,Vậy thì bắt đầu mở cửa nào.
Dialogue: 10,0:16:45.70,0:16:46.53,Default,Io/Hime,0000,0000,0000,,Vâng!
Dialogue: 10,0:16:46.53,0:16:48.32,Default,Tsu,0000,0000,0000,,V-Vâng.
Dialogue: 10,0:16:48.32,0:16:50.01,Default,Miiko,0000,0000,0000,,Cố lên nhé!
Dialogue: 10,0:16:53.79,0:16:56.42,Default,Io,0000,0000,0000,,Vậy thì cùng cố gắng nào.
Dialogue: 10,0:16:56.42,0:16:57.54,Default,Hime/Tsu,0000,0000,0000,,Ờ!
Dialogue: 10,0:16:59.54,0:17:01.63,Default,Io,0000,0000,0000,,Chào quý khách!
Dialogue: 10,0:17:01.63,0:17:05.05,Default,Io,0000,0000,0000,,Quý khách có muốn mua bánh Giáng sinh của tiệm Hatch Potch không ạ?
Dialogue: 10,0:17:05.71,0:17:07.48,Default,Tsu,0000,0000,0000,,Chào quý khách.
Dialogue: 10,0:17:08.03,0:17:09.97,Default,Mayo,0000,0000,0000,,Một cái bánh nhé?
Dialogue: 10,0:17:09.97,0:17:12.08,Default,Io,0000,0000,0000,,Cảm ơn quý khách.
Dialogue: 10,0:17:12.87,0:17:14.07,Default,Tsu,0000,0000,0000,,Đây.
Dialogue: 10,0:17:14.76,0:17:16.31,Default,Io,0000,0000,0000,,Chào quý khách!
Dialogue: 10,0:17:16.31,0:17:17.93,Default,Io,0000,0000,0000,,Hai cái phải không ạ?
Dialogue: 10,0:17:17.93,0:17:19.56,Default,Io,0000,0000,0000,,Càm ơn quý khách!
Dialogue: 10,0:17:20.58,0:17:21.74,Default,Tsu,0000,0000,0000,,Io...
Dialogue: 10,0:17:25.81,0:17:29.68,Default,Mayo,0000,0000,0000,,Tsumiki-san! Có phải gánh nặng công việc làm cậu bị chảy máu mũi không?!{Original - Did your nose start bleeding from working too hard?!}
Dialogue: 10,0:17:30.76,0:17:33.50,Default,Io,0000,0000,0000,,Cậu không cần phải ráng quá sức đâu.
Dialogue: 10,0:17:33.50,0:17:34.75,Default,Tsu,0000,0000,0000,,Đây không phải là
Dialogue: 10,0:17:34.75,0:17:35.74,Default,Saki,0000,0000,0000,,À rá! {shorten this to Ah?}{Audio matching}
Dialogue: 10,0:17:36.34,0:17:38.97,Default,Saki,0000,0000,0000,,Mọi người cũng làm việc ở đây à?
Dialogue: 10,0:17:38.97,0:17:39.83,Default,Kana,0000,0000,0000,,Merry!
Dialogue: 10,0:17:39.83,0:17:41.22,Default,Mayo,0000,0000,0000,,Merry!
Dialogue: 10,0:17:41.22,0:17:43.17,Default,Mayo,0000,0000,0000,,Tụi mình chỉ phụ bán ngày hôm nay thôi.
Dialogue: 10,0:17:43.17,0:17:44.24,Default,Io,0000,0000,0000,,Xin chào.
Dialogue: 10,0:17:44.24,0:17:46.67,Default,Io,0000,0000,0000,,Các cậu ghé qua dùng trà à?
Dialogue: 10,0:17:46.67,0:17:48.84,Default,Saki,0000,0000,0000,,Ừ và để ăn ít bánh luôn.
Dialogue: 10,0:17:50.26,0:17:52.47,Default,Kana,0000,0000,0000,,Vậy ra đây là bánh kem phiên bản Giáng sinh của Hatch Potch...
Dialogue: 10,0:17:52.47,0:17:55.44,Default,Mayo,0000,0000,0000,,Rất tuyệt đó, nó sẽ làm cậu phải chảy máu mũi!
Dialogue: 10,0:17:55.44,0:17:56.52,Default,Kana,0000,0000,0000,,Cái gì chứ?!
Dialogue: 10,0:17:56.52,0:17:58.48,Default,Saki,0000,0000,0000,,Cậu đã thêm gì vào trong đó vậy?
Dialogue: 10,0:17:58.97,0:18:00.73,Default,Io,0000,0000,0000,,Chắc là tình yêu.
Dialogue: 10,0:18:03.27,0:18:06.91,Default,Saki,0000,0000,0000,,Đã đến đây rồi thì mình cũng phải mua 1 cái bánh Giáng sinh thôi.
Dialogue: 10,0:18:06.91,0:18:08.16,Default,Kana,0000,0000,0000,,Mình cũng lấy 1 cái!
Dialogue: 10,0:18:08.16,0:18:10.23,Default,Kana,0000,0000,0000,,Mình yêu bánh kem ở tiệm Hatch Potch lắm!
Dialogue: 10,0:18:10.23,0:18:12.72,Default,Mayo,0000,0000,0000,,Cảm ơn nhiều nha!
Dialogue: 10,0:18:12.72,0:18:15.50,Default,Io,0000,0000,0000,,Mà các cậu có vào trong dùng bánh luôn không?
Dialogue: 10,0:18:15.50,0:18:17.47,Default,Saki,0000,0000,0000,,Mình sẽ đem cái này về.
Dialogue: 10,0:18:17.47,0:18:21.12,Default,Mayo,0000,0000,0000,,Nhưng mà các cậu là khách hàng đặc biệt nên sẽ có một chút quà phụ.
Dialogue: 10,0:18:21.97,0:18:25.59,Default,Mayo,0000,0000,0000,,Santa Io sẽ xoa đầu các cậu như một món quà Giáng sinh sớm!
Dialogue: 10,0:18:25.59,0:18:27.15,Default,Io,0000,0000,0000,,Ai muốn vậy chứ?
Dialogue: 10,0:18:27.25,0:18:28.63,Default,Kana,0000,0000,0000,,Mình mua!
Dialogue: 10,0:18:29.27,0:18:31.08,Default,Kana,0000,0000,0000,,Hãy nhẹ nhàng nha. {original please do it gently}
Dialogue: 10,0:18:36.06,0:18:37.99,Default,Mayo,0000,0000,0000,,Chào quý khách!
Dialogue: 10,0:18:39.42,0:18:41.69,Default,Saka,0000,0000,0000,,Mình đem thêm bánh này.
Dialogue: 10,0:18:41.69,0:18:44.07,Default,Saka,0000,0000,0000,,Mấy cái cuối rồi đấy.
Dialogue: 10,0:18:44.07,0:18:45.07,Default,Io,0000,0000,0000,,Ờ.
Dialogue: 10,0:18:46.43,0:18:50.83,Default,Saka,0000,0000,0000,,Bánh bên trong cũng bán gần hết rồi Hime-chi chắc sắp ra giúp các cậu rồi đó.
Dialogue: 10,0:18:50.83,0:18:55.07,Default,Io,0000,0000,0000,,Tụi này bán cũng được lắm chắc sẽ hết nhanh thôi.
Dialogue: 10,0:18:55.07,0:18:55.96,Default,Tsu,0000,0000,0000,,Đúng đó.
Dialogue: 10,0:18:55.96,0:19:00.98,Default,Mayo,0000,0000,0000,,Nhưng mà sao có nhiều khách nữ vậy và họ cũng không có bạn trai nữa?
Dialogue: 10,0:19:00.98,0:19:02.71,Default,Tsu,0000,0000,0000,,Mình không nghĩ vậy đâu.
Dialogue: 10,0:19:03.19,0:19:06.97,Default,Saka,0000,0000,0000,,Mình chắc bánh là tình yêu của họ.
Dialogue: 10,0:19:07.89,0:19:10.47,Default,Io,0000,0000,0000,,Đừng có nói vậy vào Giáng sinh.
Dialogue: 10,0:19:11.58,0:19:13.77,Default,Hime,0000,0000,0000,,Gần hết rồi à!
Dialogue: 10,0:19:13.77,0:19:18.23,Default,Io,0000,0000,0000,,Ừ. Sắp tối rồi nên nhiều người cũng đi mua.
Dialogue: 10,0:19:18.23,0:19:22.17,Default,Hime,0000,0000,0000,,Mình nghĩ mua bánh cho ngày Giáng sinh là chuyện đương nhiên.
Dialogue: 10,0:19:22.17,0:19:23.86,Default,Hime,0000,0000,0000,,Đặc biệt là con gái.
Dialogue: 10,0:19:23.86,0:19:25.06,Default,Saka,0000,0000,0000,,Quả nhiên mình đúng, bánh là
Dialogue: 10,0:19:25.06,0:19:26.49,Default,Io,0000,0000,0000,,Dừng lại được rồi đó.
Dialogue: 10,0:19:26.49,0:19:28.41,Default,Hime,0000,0000,0000,,Hể? Dừng lại gì cơ?
Dialogue: 10,0:19:28.41,0:19:30.87,Default,Io,0000,0000,0000,,À... không, hồi nãy Sakaki nói mấy thứ kỳ quặc ấy mà.
Dialogue: 10,0:19:30.87,0:19:33.04,Default,Mayo,0000,0000,0000,,Tình yêu của họ là...
Dialogue: 10,0:19:33.04,0:19:34.32,Default,Santa,0000,0000,0000,,Hoho!
Dialogue: 10,0:19:34.32,0:19:35.35,Default,Kid,0000,0000,0000,,Yay!
Dialogue: 10,0:19:35.35,0:19:36.96,Default,Santa,0000,0000,0000,,Hohoho!
Dialogue: 10,0:19:36.96,0:19:39.75,Default,Santa,0000,0000,0000,,Quà của con đây!
Dialogue: 10,0:19:39.75,0:19:41.67,Default,Kid,0000,0000,0000,,Cảm ơn ông Santa!
Dialogue: 10,0:19:41.67,0:19:42.94,Default,Mayo,0000,0000,0000,,Santa Claw(móng vuốt)!
Dialogue: 10,0:19:42.94,0:19:45.29,Default,Mother,0000,0000,0000,,Dừng lại đi! Santa sắp nghẻo rồi!
Dialogue: 10,0:19:45.29,0:19:47.51,Default,Hime,0000,0000,0000,,Sao lại như vậy được chứ!
Dialogue: 10,0:19:47.51,0:19:49.03,Default,Io,0000,0000,0000,,Đó không phải là tên ông ấy...
Dialogue: 10,0:19:49.03,0:19:50.01,Default,Saka,0000,0000,0000,,Claw... {ぐわし yay for editor guesslating}
Dialogue: 10,0:19:52.01,0:19:54.61,Default,Erryone,0000,0000,0000,,Cảm ơn sự ủng hộ của quý khách!
Dialogue: 10,0:19:55.99,0:19:58.02,Default,Erryone,0000,0000,0000,,Hết rồi!
Dialogue: 10,0:20:00.82,0:20:02.27,Default,Miiko,0000,0000,0000,,Cảm ơn các em nha.
Dialogue: 10,0:20:02.27,0:20:06.29,Default,Miiko,0000,0000,0000,,Chị có làm bánh cho các em đây.
Dialogue: 10,0:20:07.20,0:20:08.22,Default,Mayo,0000,0000,0000,,Yay!
Dialogue: 10,0:20:08.22,0:20:09.28,Default,Tsu,0000,0000,0000,,Bánh kem...
Dialogue: 10,0:20:09.41,0:20:11.79,Default,Saka,0000,0000,0000,,Hãy quên chuyện calo đi và tận hưởng nào.
Dialogue: 10,0:20:26.06,0:20:27.38,Default,Saka,0000,0000,0000,,Mọi người hôm nay làm tốt lắm!
Dialogue: 10,0:20:27.38,0:20:28.89,Default,Io,0000,0000,0000,,Cậu cũng vậy.
Dialogue: 10,0:20:28.89,0:20:30.63,Default,Hime,0000,0000,0000,,Làm tốt lắm!
Dialogue: 10,0:20:30.63,0:20:31.89,Default,Tsu,0000,0000,0000,,Tốt lắm.
Dialogue: 10,0:20:31.89,0:20:35.60,Default,Mayo,0000,0000,0000,,Đừng có quên tiệc Giáng sinh vào ngày mai đó!
Dialogue: 10,0:20:35.60,0:20:36.37,Default,Hime,0000,0000,0000,,Rồi!
Dialogue: 10,0:20:36.37,0:20:41.65,Default,Mayo,0000,0000,0000,,À, nếu mai Tsumiki-san không có mặt cũng không sao đâu.
Dialogue: 10,0:20:41.65,0:20:45.15,Default,Mayo,0000,0000,0000,,Bởi vì,
Dialogue: 10,0:20:45.15,0:20:48.95,Default,Mayo,0000,0000,0000,,nếu cậu muốn có một Giáng sinh đầy tình thương mến thương với Io-san thì cứ tận hưởng đi.
Dialogue: 10,0:20:52.22,0:20:55.58,Default,Saka,0000,0000,0000,,Mayoi! Hãy trở lại nhé!
Dialogue: 10,0:21:08.45,0:21:11.60,Default,Io,0000,0000,0000,,Làm việc chung với mọi người vui thật ha.
Dialogue: 10,0:21:16.61,0:21:21.90,Default,Tsu,0000,0000,0000,,Mình cũng vui khi hai đứa được ở bên nhau.
Dialogue: 10,0:21:43.62,0:21:45.34,Default,Tsu,0000,0000,0000,,Tuyết rơi rồi.
Dialogue: 10,0:21:50.67,0:21:52.97,Default,Io,0000,0000,0000,,Ngay mai tiệc mới bắt đầu,
Dialogue: 10,0:21:52.97,0:21:57.10,Default,Io,0000,0000,0000,,nhưng tụi mình bắt đầu sớm một chút nhé hãy gọi nó là Giáng sinh trắng đi.
Dialogue: 10,0:22:01.25,0:22:03.00,Default,Io,0000,0000,0000,,Đứng nói với ai nhe.
Dialogue: 10,0:22:04.22,0:22:04.85,Default,Tsu,0000,0000,0000,,Ừm.
Dialogue: 10,0:22:08.37,0:22:10.36,Default,Tsu/Io,0000,0000,0000,,{\pos(640,700)}Merry Christmas.
Dialogue: 0,0:23:41.87,0:23:45.10,Default,Kids,0000,0000,0000,,Acchi Kocchi Kindergarten!
Dialogue: 0,0:23:48.68,0:23:51.45,Default,Io,0000,0000,0000,,{\an8}Hime-chan, em đang vẽ gì vậy?
Dialogue: 0,0:23:51.45,0:23:53.28,Default,Hime,0000,0000,0000,,{\an8}Io-tentei!
Dialogue: 0,0:23:53.28,0:23:56.36,Default,Io,0000,0000,0000,,{\an8}Ồ đẹp đó nha!
Dialogue: 0,0:23:56.36,0:23:58.48,Default,Io,0000,0000,0000,,{\an8}Em tuyệt lắm, Hime-chan.
Dialogue: 0,0:23:57.28,0:23:59.28,Default,,0000,0000,0000,,



